# Directory-specific aliases for aiarcheology project
# This file is loaded automatically by direnv when entering the directory
#
# To enable: direnv allow

# Add local binaries to PATH
PATH_add "$HOME/.local/bin"
PATH_add "$HOME/.local/lib/swiftgen/bin"

# Project aliases (prefixed with 'aia' to avoid conflicts)
aiasetup() { swift run --package-path Tools ProjectTool setup; }
aiaswiftlint() { ./scripts/swiftlint.sh "$@"; }
aiaswiftgen() { ./scripts/swiftgen.sh generate; }
aiaharmonize() { ./scripts/harmonize.sh "$@"; }
aiaunittests() { ./scripts/unittest.sh "$@"; }
aialocalization() { ./scripts/localization.sh "$@"; }
aiapipeline() {
    echo "🔄 Running aiapipeline: swiftgen → swiftlint → localization → harmonize → unittests"
    # Localization sits early on purpose: it is pure Python over the catalog, needs no Xcode, and
    # finishes in about a second — so a missing translation fails before the slow steps run.
    aiaswiftgen && aiaswiftlint && aialocalization && aiaharmonize && aiaunittests
}

export -f aiasetup aiaswiftlint aiaswiftgen aiaharmonize aiaunittests aialocalization aiapipeline
