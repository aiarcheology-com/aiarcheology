{
  "$schema": "./node_modules/wrangler/config-schema.json",

  // The bare top-level config declares NO bindings and is NEVER deployed. Wrangler does not
  // inherit bindings into env blocks, so each environment below re-declares every one of them
  // with its own resource id. Deploy only with `--env staging` / `--env production`.
  "name": "aia-findings",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  // Invocation logs record the method and full URL of every request, and these URLs carry finding
  // ids. Structured logs the code emits deliberately are kept; the automatic ones are not.
  "observability": { "enabled": true, "logs": { "enabled": true, "invocation_logs": false } },

  "env": {
    "staging": {
      // Finishes purges the user.deleted webhook never completed (AIA-0773). Six-hourly: the
      // work is a retry of something already attempted, so latency does not matter, and a
      // straggler that survives four runs in a day is a real problem rather than a blip.
      "triggers": { "crons": ["0 */6 * * *"] },
      "r2_buckets": [
        { "binding": "FINDINGS", "bucket_name": "aia-findings-staging", "jurisdiction": "eu" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aia-findings-staging",
          "database_id": "8a5550ce-673c-4ba2-bcb7-57337d5e0009"
        }
      ],
      "vars": {
        "CLERK_ISSUER": "https://advanced-tetra-5.clerk.accounts.dev",
        "CLERK_JWKS_URL": "https://advanced-tetra-5.clerk.accounts.dev/.well-known/jwks.json",
        "USER_BYTE_LIMIT": 52428800,
        // Staging and production draw on ONE account-wide free tier, and each environment's
        // counter can only see its own bucket -- so the ceilings are a partition of one budget,
        // not two independent limits. 512 MiB here plus 7.5 GiB in production is 8 GiB against a
        // 10 GB (9.31 GiB) allowance, leaving room for bytes neither counter can see.
        "GLOBAL_BYTE_CEILING": 536870912,
        "IMAGE_BYTE_LIMIT": 16777216,
        "META_BYTE_LIMIT": 65536
      }
    },

    "production": {
      // Finishes purges the user.deleted webhook never completed (AIA-0773). Six-hourly: the
      // work is a retry of something already attempted, so latency does not matter, and a
      // straggler that survives four runs in a day is a real problem rather than a blip.
      "triggers": { "crons": ["0 */6 * * *"] },
      "r2_buckets": [
        { "binding": "FINDINGS", "bucket_name": "aia-findings-production", "jurisdiction": "eu" }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "aia-findings-production",
          "database_id": "ff7411c4-3add-42aa-836f-eae0b06b6366"
        }
      ],
      "vars": {
        // The production Clerk instance, verified live 2026-08-26: its own
        // /.well-known/openid-configuration reports this issuer and this jwks_uri. Public URLs, so
        // they are vars rather than secrets -- the same shape as the staging pair above.
        //
        // A token from the DEVELOPMENT instance must be rejected here. That is the check worth
        // running after a deploy: every other test passes whether or not the issuer is enforced.
        "CLERK_ISSUER": "https://clerk.aiarcheology.com",
        "CLERK_JWKS_URL": "https://clerk.aiarcheology.com/.well-known/jwks.json",
        "USER_BYTE_LIMIT": 52428800,
        "GLOBAL_BYTE_CEILING": 8053063680,
        "IMAGE_BYTE_LIMIT": 16777216,
        "META_BYTE_LIMIT": 65536
      }
    }
  }
}
