{
  "schemaVersion": 1,
  "name": "backup-off",
  "installations": {"a": {"launch": {"flags": {"isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": true, "isAnalyticsEnabled": true, "isCrossDeviceAnalyticsIdentityEnabled": false}, "stage": ["ios/MLBrowserUnitTests/Fixtures/terrain_iphone.png"]}}, "b": {"launch": {"flags": {"isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": true, "isAnalyticsEnabled": true, "isCrossDeviceAnalyticsIdentityEnabled": false}}}},
  "steps": [
    {"on": "a", "name": "a fresh install on real auth, the fixture staged; cross-device analytics identity pinned off, so no account question", "wait": {"condition": "ready", "timeout": 120}, "expect": [{"route": "welcome"}, {"equals": {"pointer": "/state/offer", "value": "freeAccess"}}, {"equals": {"pointer": "/context/backendEnvironment", "value": "development"}}, {"equals": {"pointer": "/context/auth/usesRealAuth", "value": true}}]},
    {"on": "a", "name": "continue past the free-access Welcome screen", "perform": {"action": "continue"}, "expect": [{"route": "tour"}]},
    {"on": "a", "perform": {"action": "skip"}, "expect": [{"route": "consent"}]},
    {"on": "a", "perform": {"action": "deny"}, "expect": [{"route": "home"}, {"equals": {"pointer": "/context/analytics/enabled", "value": false}}]},
    {"on": "a", "name": "open the menu; the first model is a bundled demo detector", "goto": "drawer", "capture": {"model": "/state/models/0/id"}, "expect": [{"equals": {"pointer": "/state/models/0/name", "value": "Fortification relicts in LIDAR 1 (greyscale)"}}]},
    {"on": "a", "name": "switch it on", "perform": {"action": "enable", "arguments": {"id": "${model}"}}, "expect": [{"equals": {"pointer": "/result/loaded", "value": true}}]},
    {"on": "a", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "a", "name": "sign in to the automation account", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}, {"route": "drawer"}]},
    {"on": "a", "goto": "findings", "expect": [{"route": "findings"}]},
    {"on": "a", "name": "known-empty start: a successful synchronize finds no live rows on the account", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "drawer"}]},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "turn back-up off, as Settings' switch does", "perform": {"action": "set-backup", "arguments": {"enabled": false}}, "expect": [{"equals": {"pointer": "/state/backUpEnabled", "value": false}}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "drawer"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "home"}]},
    {"on": "a", "name": "detect on the staged image with the real model (at least one detection)", "perform": {"action": "detect-image", "arguments": {"image": "terrain_iphone.png"}}, "expect": [{"exists": "/result/detections/0/label"}]},
    {"on": "a", "perform": {"action": "pick", "arguments": {"detection": 0}}, "expect": [{"route": "save-finding"}]},
    {"on": "a", "name": "save a finding while signed in with back-up off; the sync it triggers has run when this returns", "perform": {"action": "save", "arguments": {"title": "Kept local"}}, "capture": {"finding": "/result/id"}, "expect": [{"exists": "/result/id"}, {"route": "home"}]},
    {"on": "a", "goto": "drawer"},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "nothing uploads: the finding is still owed after a successful synchronize", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"equals": {"pointer": "/state/findings/0/id", "value": "${finding}"}}, {"equals": {"pointer": "/state/findings/0/backup", "value": "owed"}}, {"absent": "/state/findings/1"}]},
    {"on": "b", "name": "b is a fresh install", "wait": {"condition": "ready", "timeout": 120}, "expect": [{"route": "welcome"}, {"equals": {"pointer": "/state/offer", "value": "freeAccess"}}, {"equals": {"pointer": "/context/backendEnvironment", "value": "development"}}, {"equals": {"pointer": "/context/auth/usesRealAuth", "value": true}}]},
    {"on": "b", "name": "continue past the free-access Welcome screen", "perform": {"action": "continue"}, "expect": [{"route": "tour"}]},
    {"on": "b", "perform": {"action": "skip"}, "expect": [{"route": "consent"}]},
    {"on": "b", "perform": {"action": "deny"}, "expect": [{"route": "home"}, {"equals": {"pointer": "/context/analytics/enabled", "value": false}}]},
    {"on": "b", "goto": "drawer"},
    {"on": "b", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "b", "name": "b signs in to the same account", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}, {"route": "drawer"}]},
    {"on": "b", "goto": "findings"},
    {"on": "b", "name": "the account holds no finding: nothing was uploaded", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]}
  ],
  "teardown": [
    {"on": "a", "name": "a: answer a pending analytics question", "perform": {"action": "deny"}, "bestEffort": true, "unless": [{"notRoute": "consent"}]},
    {"on": "a", "name": "a: leave the save sheet", "perform": {"action": "cancel"}, "bestEffort": true, "unless": [{"notRoute": "save-finding"}]},
    {"on": "a", "name": "a: leave the findings or account sheet", "perform": {"action": "close"}, "bestEffort": true, "unless": [{"notRoute": "findings"}, {"notRoute": "account"}]},
    {"on": "a", "name": "a: decline a pending back-up question (never uploads)", "perform": {"action": "decline"}, "bestEffort": true, "unless": [{"notRoute": "backup-consent"}]},
    {"on": "a", "name": "a: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "a", "name": "a: open the findings", "goto": "findings"},
    {"on": "a", "name": "a: settle in-flight sync", "perform": {"action": "synchronize"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: remove every local finding (tombstones for each)", "perform": {"action": "remove-all-findings"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "a: send the tombstones; the account holds no live rows", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]},
    {"on": "a", "name": "a: the account's bytes are freed (advisory: reservations can linger 24 h)", "expect": [{"equals": {"pointer": "/state/usage/used", "value": 0}}], "bestEffort": true},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: sign out", "perform": {"action": "sign-out"}},
    {"on": "b", "name": "b: answer a pending analytics question", "perform": {"action": "deny"}, "bestEffort": true, "unless": [{"notRoute": "consent"}]},
    {"on": "b", "name": "b: leave the findings or account sheet", "perform": {"action": "close"}, "bestEffort": true, "unless": [{"notRoute": "findings"}, {"notRoute": "account"}]},
    {"on": "b", "name": "b: decline a pending back-up question (never uploads)", "perform": {"action": "decline"}, "bestEffort": true, "unless": [{"notRoute": "backup-consent"}]},
    {"on": "b", "name": "b: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "b", "goto": "account"},
    {"on": "b", "name": "b: sign out", "perform": {"action": "sign-out"}}
  ]
}
