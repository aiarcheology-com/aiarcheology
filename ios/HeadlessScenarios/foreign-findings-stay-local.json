{
  "schemaVersion": 1,
  "name": "foreign-findings-stay-local",
  "installations": {"a": {"launch": {"mockSubscription": "subscribed", "flags": {"isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": false, "isCrossDeviceAnalyticsIdentityEnabled": false}, "stage": ["ios/MLBrowserUnitTests/Fixtures/terrain_iphone.png"]}}, "b": {"launch": {"mockSubscription": "subscribed", "flags": {"isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": false, "isCrossDeviceAnalyticsIdentityEnabled": false}}}},
  "steps": [
    {"on": "a", "name": "a fresh install on real auth, the fixture staged; cross-device analytics identity pinned off, so no account question", "wait": {"condition": "ready", "timeout": 120}, "expect": [{"route": "tour"}, {"equals": {"pointer": "/context/backendEnvironment", "value": "development"}}, {"equals": {"pointer": "/context/auth/usesRealAuth", "value": true}}]},
    {"on": "a", "perform": {"action": "skip"}, "expect": [{"route": "consent"}]},
    {"on": "a", "perform": {"action": "deny"}, "expect": [{"route": "home"}]},
    {"on": "a", "name": "open the menu; the first model is a bundled demo detector", "goto": "drawer", "capture": {"model": "/state/models/0/id"}, "expect": [{"equals": {"pointer": "/state/models/0/name", "value": "Fortification relicts in LIDAR 1 (greyscale)"}}]},
    {"on": "a", "name": "switch it on", "perform": {"action": "enable", "arguments": {"id": "${model}"}}, "expect": [{"equals": {"pointer": "/result/loaded", "value": true}}]},
    {"on": "a", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "a", "name": "user X signs in", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}, {"route": "drawer"}]},
    {"on": "a", "goto": "findings", "expect": [{"route": "findings"}]},
    {"on": "a", "name": "known-empty start: a successful synchronize finds no live rows on X's account", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "drawer"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "home"}]},
    {"on": "a", "name": "detect on the staged image with the real model (at least one detection)", "perform": {"action": "detect-image", "arguments": {"image": "terrain_iphone.png"}}, "expect": [{"exists": "/result/detections/0/label"}]},
    {"on": "a", "perform": {"action": "pick", "arguments": {"detection": 0}}, "expect": [{"route": "save-finding"}]},
    {"on": "a", "name": "X saves a finding; the upload has run when this returns", "perform": {"action": "save", "arguments": {"title": "X's finding"}}, "capture": {"finding": "/result/id"}, "expect": [{"exists": "/result/id"}, {"route": "home"}]},
    {"on": "a", "name": "it is X's, backed up to X's account", "wait": {"condition": "backed-up", "arguments": {"id": "${finding}"}, "timeout": 60}},
    {"on": "a", "goto": "drawer"},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: sign out", "perform": {"action": "sign-out"}},
    {"on": "a", "name": "X is signed out", "expect": [{"equals": {"pointer": "/context/auth/signedIn", "value": false}}, {"equals": {"pointer": "/context/auth/accountPresent", "value": false}}]},
    {"on": "a", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "a", "name": "user Y signs in on the same installation", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless-other+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}]},
    {"on": "a", "name": "Y is asked about X's finding instead of it uploading", "wait": {"condition": "route", "arguments": {"route": "backup-consent"}, "timeout": 60}, "expect": [{"equals": {"pointer": "/state/count", "value": 1}}]},
    {"on": "a", "name": "Y keeps it on the device", "perform": {"action": "decline"}},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "X's finding stays local for Y", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"equals": {"pointer": "/state/findings/0/id", "value": "${finding}"}}, {"equals": {"pointer": "/state/findings/0/backup", "value": "keptOnDevice"}}, {"absent": "/state/findings/1"}]},
    {"on": "b", "name": "b is a fresh install", "wait": {"condition": "ready", "timeout": 120}, "expect": [{"route": "tour"}, {"equals": {"pointer": "/context/backendEnvironment", "value": "development"}}, {"equals": {"pointer": "/context/auth/usesRealAuth", "value": true}}]},
    {"on": "b", "perform": {"action": "skip"}, "expect": [{"route": "consent"}]},
    {"on": "b", "perform": {"action": "deny"}, "expect": [{"route": "home"}]},
    {"on": "b", "goto": "drawer"},
    {"on": "b", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "b", "name": "b signs in as Y", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless-other+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}, {"route": "drawer"}]},
    {"on": "b", "goto": "findings"},
    {"on": "b", "name": "Y's account holds nothing: X's finding never uploaded to it", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]}
  ],
  "teardown": [
    {"on": "a", "name": "a: answer a pending analytics question", "perform": {"action": "deny"}, "bestEffort": true},
    {"on": "a", "name": "a: leave the save sheet", "perform": {"action": "cancel"}, "bestEffort": true},
    {"on": "a", "name": "a: leave the findings or account sheet", "perform": {"action": "close"}, "bestEffort": true},
    {"on": "a", "name": "a: decline a pending back-up question (never uploads)", "perform": {"action": "decline"}, "bestEffort": true},
    {"on": "a", "name": "a: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: sign whoever is signed in out", "perform": {"action": "sign-out"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: X signs back in to remove X's rows", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless+clerk_test@example.com", "code": "424242"}}},
    {"on": "a", "name": "a: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "a", "name": "a: open the findings", "goto": "findings"},
    {"on": "a", "name": "a: settle in-flight sync", "perform": {"action": "synchronize"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: remove every local finding (tombstones for each)", "perform": {"action": "remove-all-findings"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "a: send the tombstones; the account holds no live rows", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]},
    {"on": "a", "name": "a: the account's bytes are freed (advisory: reservations can linger 24 h)", "expect": [{"equals": {"pointer": "/state/usage/used", "value": 0}}], "bestEffort": true},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: sign out", "perform": {"action": "sign-out"}},
    {"on": "b", "name": "b: answer a pending analytics question", "perform": {"action": "deny"}, "bestEffort": true},
    {"on": "b", "name": "b: leave the findings or account sheet", "perform": {"action": "close"}, "bestEffort": true},
    {"on": "b", "name": "b: decline a pending back-up question (never uploads)", "perform": {"action": "decline"}, "bestEffort": true},
    {"on": "b", "name": "b: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "b", "goto": "account"},
    {"on": "b", "name": "b: sign out", "perform": {"action": "sign-out"}}
  ]
}
