{
  "schemaVersion": 1,
  "name": "installations-are-isolated",
  "installations": {
    "a": {
      "launch": {
        "mockSubscription": "subscribed",
        "flags": { "isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": false, "isCrossDeviceAnalyticsIdentityEnabled": false }
      }
    },
    "b": {
      "launch": {
        "mockSubscription": "subscribed",
        "flags": { "isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": false, "isCrossDeviceAnalyticsIdentityEnabled": false }
      }
    }
  },
  "steps": [
    { "on": "a", "name": "a launches", "wait": { "condition": "ready", "timeout": 120 }, "expect": [ { "route": "tour" } ] },
    { "on": "a", "perform": { "action": "skip" } },
    { "on": "a", "perform": { "action": "deny" }, "expect": [ { "route": "home" } ] },
    { "on": "a", "goto": "drawer", "capture": { "model": "/state/models/0/id" } },
    { "on": "a", "name": "a switches a model on", "perform": { "action": "enable", "arguments": { "id": "${model}" } },
      "expect": [ { "equals": { "pointer": "/result/loaded", "value": true } } ] },
    { "on": "b", "name": "b is a fresh install, whatever a did", "wait": { "condition": "ready", "timeout": 120 },
      "expect": [ { "route": "tour" } ] },
    { "on": "b", "perform": { "action": "skip" } },
    { "on": "b", "perform": { "action": "deny" }, "expect": [ { "route": "home" } ] },
    { "on": "b", "name": "b's models are its own: none switched on", "goto": "drawer",
      "expect": [ { "equals": { "pointer": "/state/models/0/enabled", "value": false } } ] },
    { "on": "a", "name": "a's model is still on", "expect": [ { "equals": { "pointer": "/state/models/0/enabled", "value": true } } ] }
  ]
}
