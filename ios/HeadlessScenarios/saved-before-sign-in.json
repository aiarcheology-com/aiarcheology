{
  "schemaVersion": 1,
  "name": "saved-before-sign-in",
  "installations": {"a": {"launch": {"flags": {"isPaymentsEnabled": true, "isFreeAccessPeriodEnabled": true, "isAnalyticsEnabled": true, "isCrossDeviceAnalyticsIdentityEnabled": false}, "stage": ["ios/MLBrowserUnitTests/Fixtures/terrain_iphone.png"]}}},
  "steps": [
    {"on": "a", "name": "a fresh install on real auth, the fixture staged; cross-device analytics identity pinned off, so no account question", "wait": {"condition": "ready", "timeout": 120}, "expect": [{"route": "welcome"}, {"equals": {"pointer": "/state/offer", "value": "freeAccess"}}, {"equals": {"pointer": "/context/backendEnvironment", "value": "development"}}, {"equals": {"pointer": "/context/auth/usesRealAuth", "value": true}}]},
    {"on": "a", "name": "continue past the free-access Welcome screen", "perform": {"action": "continue"}, "expect": [{"route": "tour"}]},
    {"on": "a", "perform": {"action": "skip"}, "expect": [{"route": "consent"}]},
    {"on": "a", "perform": {"action": "deny"}, "expect": [{"route": "home"}, {"equals": {"pointer": "/context/analytics/enabled", "value": false}}]},
    {"on": "a", "name": "open the menu; the first model is a bundled demo detector", "goto": "drawer", "capture": {"model": "/state/models/0/id"}, "expect": [{"equals": {"pointer": "/state/models/0/name", "value": "Fortification relicts in LIDAR 1 (greyscale)"}}]},
    {"on": "a", "name": "switch it on", "perform": {"action": "enable", "arguments": {"id": "${model}"}}, "expect": [{"equals": {"pointer": "/result/loaded", "value": true}}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "home"}]},
    {"on": "a", "name": "detect on the staged image with the real model (at least one detection)", "perform": {"action": "detect-image", "arguments": {"image": "terrain_iphone.png"}}, "expect": [{"exists": "/result/detections/0/label"}]},
    {"on": "a", "perform": {"action": "pick", "arguments": {"detection": 0}}, "expect": [{"route": "save-finding"}]},
    {"on": "a", "name": "save a finding while signed out", "perform": {"action": "save", "arguments": {"title": "Saved signed out"}}, "capture": {"finding": "/result/id"}, "expect": [{"exists": "/result/id"}, {"route": "home"}]},
    {"on": "a", "goto": "drawer"},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "it is on the device with no back-up state", "expect": [{"equals": {"pointer": "/state/findings/0/id", "value": "${finding}"}}, {"equals": {"pointer": "/state/findings/0/backup", "value": "none"}}, {"absent": "/state/findings/1"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "drawer"}]},
    {"on": "a", "goto": "account", "expect": [{"route": "account"}]},
    {"on": "a", "name": "sign in to the automation account", "perform": {"action": "sign-in", "arguments": {"email": "aia-headless+clerk_test@example.com", "code": "424242"}}, "expect": [{"equals": {"pointer": "/result/signedIn", "value": true}}]},
    {"on": "a", "name": "the back-up question asks about the one finding saved before sign-in", "wait": {"condition": "route", "arguments": {"route": "backup-consent"}, "timeout": 60}, "expect": [{"equals": {"pointer": "/state/count", "value": 1}}]},
    {"on": "a", "name": "back it up; the upload has run when this returns", "perform": {"action": "accept"}},
    {"on": "a", "name": "the ledger says it is backed up", "wait": {"condition": "backed-up", "arguments": {"id": "${finding}"}, "timeout": 60}},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "the account holds exactly that finding, backed up", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"equals": {"pointer": "/state/findings/0/id", "value": "${finding}"}}, {"equals": {"pointer": "/state/findings/0/backup", "value": "backedUp"}}, {"absent": "/state/findings/1"}]},
    {"on": "a", "perform": {"action": "close"}, "expect": [{"route": "drawer"}]}
  ],
  "teardown": [
    {"on": "a", "name": "a: answer a pending analytics question", "perform": {"action": "deny"}, "bestEffort": true},
    {"on": "a", "name": "a: leave the save sheet", "perform": {"action": "cancel"}, "bestEffort": true},
    {"on": "a", "name": "a: leave the findings or account sheet", "perform": {"action": "close"}, "bestEffort": true},
    {"on": "a", "name": "a: decline a pending back-up question (never uploads)", "perform": {"action": "decline"}, "bestEffort": true},
    {"on": "a", "name": "a: reach the menu", "goto": "drawer", "bestEffort": true},
    {"on": "a", "name": "a: open the findings", "goto": "findings"},
    {"on": "a", "name": "a: settle in-flight sync", "perform": {"action": "synchronize"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: remove every local finding (tombstones for each)", "perform": {"action": "remove-all-findings"}},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "findings"},
    {"on": "a", "name": "a: send the tombstones; the account holds no live rows", "perform": {"action": "synchronize"}, "expect": [{"equals": {"pointer": "/result/outcome", "value": "succeeded"}}, {"absent": "/state/findings/0"}]},
    {"on": "a", "name": "a: the account's bytes are freed (advisory: reservations can linger 24 h)", "expect": [{"equals": {"pointer": "/state/usage/used", "value": 0}}], "bestEffort": true},
    {"on": "a", "perform": {"action": "close"}},
    {"on": "a", "goto": "account"},
    {"on": "a", "name": "a: sign out", "perform": {"action": "sign-out"}}
  ]
}
