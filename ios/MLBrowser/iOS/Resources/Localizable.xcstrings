    "auth.locked.message" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يُفعَّل حسابك للوصول بعد. ML Browser في مرحلة الوصول المبكر، فانتظر قليلًا أو سجّل الخروج لتبديل الحسابات."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার অ্যাকাউন্টে এখনও অ্যাক্সেস চালু হয়নি। ML Browser আর্লি অ্যাক্সেসে আছে — একটু অপেক্ষা করুন, বা অ্যাকাউন্ট বদলাতে সাইন আউট করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Váš účet zatím nemá povolený přístup. ML Browser je v raném přístupu — vydržte, nebo se odhlaste a přepněte účet."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr Account ist noch nicht freigeschaltet. ML Browser befindet sich im Early Access – bitte haben Sie etwas Geduld oder melden Sie sich ab, um den Account zu wechseln."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your account isn't enabled for access yet. ML Browser is in early access — hang tight, or sign out to switch accounts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu cuenta aún no tiene acceso. ML Browser está en acceso anticipado: espera un poco o cierra sesión para cambiar de cuenta."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حساب شما هنوز برای دسترسی فعال نشده است. ML Browser در مرحلهٔ دسترسی زودهنگام است؛ کمی صبر کنید یا برای تعویض حساب خارج شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre compte n’a pas encore accès à l’app. ML Browser est en accès anticipé — patientez un peu, ou déconnectez-vous pour changer de compte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "החשבון שלך עדיין לא אושר לגישה. ML Browser נמצא בגישה מוקדמת — המתן בסבלנות, או התנתק כדי להחליף חשבון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके अकाउंट को अभी एक्सेस के लिए चालू नहीं किया गया है। ML Browser अर्ली एक्सेस में है — थोड़ा इंतज़ार करें, या अकाउंट बदलने के लिए साइन आउट करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A fiókja még nincs engedélyezve. Az ML Browser korai hozzáférésben érhető el – kis türelmet kérünk, vagy jelentkezzen ki a fiókváltáshoz."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje konto nie ma jeszcze włączonego dostępu. ML Browser jest we wczesnym dostępie — poczekaj chwilę lub wyloguj się, aby zmienić konto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш аккаунт ещё не открыт для доступа. ML Browser находится в раннем доступе — подождите немного или выйдите, чтобы сменить аккаунт."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш обліковий запис ще не має доступу. ML Browser у режимі раннього доступу — трохи зачекайте або вийдіть, щоб змінити обліковий запис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的账户尚未获得访问权限。ML Browser 目前处于早期体验阶段，请耐心等待，或退出登录以切换账户。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的帳號尚未取得使用權限。ML Browser 目前為搶先體驗階段 — 請再稍候，或登出以切換帳號。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的帳戶尚未獲得使用權限。ML Browser 目前處於早期體驗階段，請耐心等候，或登出以切換帳戶。"
          }
        }
      }
    },
