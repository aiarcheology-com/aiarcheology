    "download.error.interruptedNoResumeData" : {
      "comment" : "Error message when download was interrupted and cannot be resumed",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تمت مقاطعة التنزيل ولا يمكن استئنافه. يُرجى بدء التنزيل من جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডাউনলোড বাধাপ্রাপ্ত হয়েছে এবং আবার শুরু করা যাবে না। ডাউনলোডটি নতুন করে শুরু করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stahování bylo přerušeno a nelze v něm pokračovat. Spusťte stahování znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Download wurde unterbrochen und kann nicht fortgesetzt werden. Bitte starten Sie ihn neu."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Download was interrupted and cannot be resumed. Please restart the download."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La descarga se interrumpió y no se puede reanudar. Vuelve a iniciarla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دانلود قطع شد و قابل ازسرگیری نیست. لطفاً دانلود را دوباره شروع کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Le téléchargement a été interrompu et ne peut pas reprendre. Veuillez le relancer."
          }
