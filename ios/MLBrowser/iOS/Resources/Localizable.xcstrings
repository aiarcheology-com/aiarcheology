    },
    "paywall.restoreFailed.message" : {
      "comment" : "Shown when a restore does not complete. Neutral wording: AppStore.sync() throws on user cancellation as well as connectivity failure.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّرت استعادة مشترياتك. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার কেনাকাটা পুনরুদ্ধার করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
