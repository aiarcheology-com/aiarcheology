          "stringUnit" : {
            "state" : "translated",
            "value" : "Privacy Policy not available. Missing in the bundle?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de privacidad no disponible. ¿Falta en el paquete?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سیاست حریم خصوصی موجود نیست. آیا در بسته گم شده است؟"
          }
        },
        "fr" : {
