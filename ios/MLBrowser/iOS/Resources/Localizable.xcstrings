    "slideshow.slide4.description": {
      "comment": "Slideshow slide 4 description - Open or download model",
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie können jedes Create ML Erkennungsmodell auf Ihr Apple-Gerät herunterladen und in die ML Browser App laden. Der ML Browser sendet Ihr Modell nirgendwohin und sammelt keine Informationen. Das Modell wird nur für die Annotationen verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can download any Create ML detection model to your Apple device and load it into the ML Browser app. The ML Browser does not send your model anywhere, or collect information. The model is used only for the annotations."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "You can download any Create ML detection model to your Apple device and load it into the ML Browser app. The ML Browser does not send your model anywhere, or collect information. The model is used only for the annotations."
          }
        },
