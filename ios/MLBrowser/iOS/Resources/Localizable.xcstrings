    "tour.capture.text" : {
      "comment" : "AIA-0333 tour bubble: capture-a-finding step",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "الآن المس أي مكان على الخريطة لتمييز اكتشافك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এবার আপনার সন্ধান চিহ্নিত করতে মানচিত্রের যেকোনো জায়গায় ট্যাপ করুন।"
