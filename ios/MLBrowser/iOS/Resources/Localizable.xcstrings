    "support.prompt.message" : {
      "comment" : "Message of the offer shown once, after the user takes a screenshot.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "إذا بدا شيء خاطئًا، يمكنك إرسال تلك اللقطة إلينا مع وصف موجز."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কিছু ভুল মনে হলে আপনি সেই স্ক্রিনশটটি একটি সংক্ষিপ্ত বিবরণসহ আমাদের পাঠাতে পারেন।"
