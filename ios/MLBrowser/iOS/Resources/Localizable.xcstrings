    "auth.environment.footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لإصدارات الاختبار فقط. يؤدي التبديل إلى تسجيل خروجك وإعادة الاتصال بنسخة Clerk المحددة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "শুধু টেস্ট বিল্ডের জন্য। বদলালে আপনি সাইন আউট হয়ে যাবেন এবং নির্বাচিত Clerk ইনস্ট্যান্সের সঙ্গে আবার যুক্ত হবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Pouze testovací sestavení. Přepnutí vás odhlásí a připojí k vybrané instanci Clerk."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nur für Testversionen. Beim Wechsel werden Sie abgemeldet und mit der gewählten Clerk-Instanz neu verbunden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Test builds only. Switching signs you out and reconnects to the selected Clerk instance."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Solo en versiones de prueba. Al cambiar se cierra tu sesión y se vuelve a conectar con la instancia de Clerk seleccionada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقط برای نسخه‌های آزمایشی. تعویض، شما را از حساب خارج و به نمونهٔ Clerk انتخاب‌شده وصل می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Versions de test uniquement. Changer d’environnement vous déconnecte et rétablit la connexion à l’instance Clerk sélectionnée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לגרסאות בדיקה בלבד. החלפה תנתק אותך ותתחבר מחדש למופע Clerk שנבחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "केवल टेस्ट बिल्ड के लिए। बदलने पर आप साइन आउट हो जाएँगे और चुने गए Clerk इंस्टेंस से फिर से कनेक्ट होंगे।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak tesztverziókhoz. A váltás kijelentkezteti, és a kiválasztott Clerk-példányhoz csatlakozik újra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tylko kompilacje testowe. Przełączenie wyloguje cię i połączy z wybraną instancją Clerk."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Только для тестовых сборок. Переключение выполнит выход и подключит к выбранному экземпляру Clerk."
          }
        },
