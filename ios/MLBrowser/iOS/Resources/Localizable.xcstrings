    "paywall.billing.immediate" : {
      "comment" : "Billing note for a user who is no longer eligible for the introductory free trial: they are charged at once. Shown only where a free trial exists to have been spent, so it never claims a trial the product does not offer.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سبق أن استُخدمت التجربة المجانية مع حساب Apple الخاص بك، لذا تبدأ الفوترة فور اشتراكك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার Apple অ্যাকাউন্টে ইতিমধ্যেই ফ্রি ট্রায়াল ব্যবহার করা হয়েছে, তাই সাবস্ক্রাইব করার সঙ্গে সঙ্গেই বিলিং শুরু হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Váš účet Apple už bezplatnou zkušební verzi využil, takže placení začne hned po objednání předplatného."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr Apple-Account hat den Gratiszeitraum bereits genutzt. Die Abrechnung beginnt daher, sobald Sie das Abo abschließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your Apple Account has already used the free trial, so billing starts as soon as you subscribe."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu cuenta de Apple ya ha usado la prueba gratuita, así que el cobro empieza en cuanto te suscribas."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پیش‌تر با حساب Apple شما از دورهٔ آزمایشی رایگان استفاده شده است، بنابراین صورت‌حساب به‌محض مشترک شدن آغاز می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre compte Apple a déjà utilisé l'essai gratuit : la facturation commence dès que vous vous abonnez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "חשבון Apple שלך כבר ניצל את תקופת הניסיון בחינם, ולכן החיוב יתחיל מיד עם ההרשמה למינוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपके Apple खाते पर मुफ़्त ट्रायल पहले ही इस्तेमाल हो चुका है, इसलिए सब्सक्राइब करते ही बिलिंग शुरू हो जाती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az Apple-fiókja már felhasználta az ingyenes próbaidőszakot, ezért a számlázás az előfizetéssel azonnal megkezdődik."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twoje konto Apple wykorzystało już bezpłatny okres próbny, więc naliczanie opłat rozpocznie się od razu po wykupieniu subskrypcji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "В вашей учётной записи Apple бесплатный пробный период уже использован, поэтому оплата начнётся сразу после оформления подписки."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "У вашому обліковому записі Apple безкоштовний пробний період уже використано, тому оплата почнеться одразу після оформлення передплати."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 Apple 账户已使用过免费试用，因此订阅后会立即开始收费。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的 Apple 帳號已使用過免費試用，因此訂閱後隨即開始計費。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
