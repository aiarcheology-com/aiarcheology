    "support.screenshotTooSmall.message" : {
      "comment" : "Shown when the selected support-email screenshot is too small to keep its details readable. %d is the required minimum number of pixels on the shortest edge.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر لقطة شاشة لا يقل ضلعها الأقصر عن %d بكسل حتى تبقى التفاصيل واضحة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এমন একটি স্ক্রিনশট বাছুন যার সবচেয়ে ছোট দিক অন্তত %d পিক্সেল, যাতে বিবরণ পড়ার মতো থাকে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte snímek obrazovky, který má na kratší straně alespoň %d pixelů, aby zůstaly detaily čitelné."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie ein Bildschirmfoto mit mindestens %d Pixeln an der kürzesten Seite, damit die Details lesbar bleiben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a screenshot with at least %d pixels on its shortest side so the details stay readable."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige una captura de pantalla con al menos %d píxeles en su lado más corto para que los detalles sigan siendo legibles."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "عکس صفحه‌ای انتخاب کنید که کوتاه‌ترین ضلع آن دست‌کم %d پیکسل باشد تا جزئیات خوانا بماند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez une capture d’écran d’au moins %d pixels sur son côté le plus court, afin que les détails restent lisibles."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחר צילום מסך שבו יש לפחות %d פיקסלים בצלע הקצרה, כדי שהפרטים יישארו קריאים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐसा स्क्रीनशॉट चुनें जिसकी सबसे छोटी भुजा कम से कम %d पिक्सेल हो, ताकि विवरण पढ़ने लायक रहें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Olyan képernyőképet válasszon, amelynek rövidebb oldala legalább %d képpont, hogy a részletek olvashatóak maradjanak."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz zrzut ekranu mający co najmniej %d pikseli na krótszym boku, aby szczegóły pozostały czytelne."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите снимок экрана, у которого меньшая сторона не менее %d пикселей, чтобы детали оставались читаемыми."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Виберіть знімок екрана, у якого менша сторона не менша за %d пікселів, щоб деталі залишалися розбірливими."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "请选择最短边至少 %d 像素的截屏，以保证细节清晰可辨。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
