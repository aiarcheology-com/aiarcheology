    "settings.subscription.trialFootnote" : {
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تستمر تجربتك المجانية حتى %@، حيث يتم عندها أول خصم."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ফ্রি ট্রায়াল %@ পর্যন্ত চলে, তখন প্রথম চার্জ নেওয়া হয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bezplatná zkušební verze běží do %@, kdy bude stržena první platba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ihr Gratiszeitraum läuft bis %@; dann erfolgt die erste Abrechnung."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Your free trial runs until %@, when the first charge is made."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tu prueba gratuita dura hasta el %@, fecha en la que se realiza el primer cargo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دورهٔ آزمایشی رایگان شما تا %@ ادامه دارد و در همان زمان نخستین پرداخت انجام می‌شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Votre essai gratuit court jusqu'au %@, date à laquelle le premier débit est effectué."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "תקופת הניסיון בחינם שלך נמשכת עד %@, ואז מתבצע החיוב הראשון."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका मुफ़्त ट्रायल %@ तक चलता है, तब पहला शुल्क लिया जाता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az ingyenes próbaidőszak eddig tart: %@ – ekkor történik az első terhelés."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Twój bezpłatny okres próbny trwa do %@, kiedy zostanie pobrana pierwsza opłata."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Бесплатный пробный период действует до %@ — тогда будет сделано первое списание."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ваш безкоштовний пробний період триває до %@ — тоді буде здійснено перше списання."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的免费试用持续到 %@，届时进行首次扣款。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的免費試用將持續到 %@，屆時會進行首次收費。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "你的免費試用至 %@ 結束，屆時進行首次扣款。"
          }
        }
      }
    },
