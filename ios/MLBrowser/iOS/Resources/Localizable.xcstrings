    "support.privacyNote" : {
      "comment" : "Footer explaining that the user reviews and sends the support email and its attachments themselves.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا يُرسَل شيء حتى ترسله بنفسك. سترى البريد كاملًا ويمكنك إزالة أي لقطة شاشة أو مرفق سجل قبل الإرسال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনি না পাঠানো পর্যন্ত কিছুই পাঠানো হয় না। আপনি পুরো ইমেলটি দেখবেন এবং পাঠানোর আগে যেকোনো স্ক্রিনশট বা অ্যাপ লগ অ্যাটাচমেন্ট সরিয়ে দিতে পারবেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nic se neodešle, dokud to neodešlete vy. Uvidíte celý e-mail a před odesláním můžete odebrat jakýkoli snímek obrazovky i přílohu s protokolem aplikace."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es wird nichts gesendet, bevor Sie es senden. Sie sehen die gesamte E-Mail und können Bildschirmfoto- oder Protokollanhänge vor dem Senden entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nothing is sent until you send it. You will see the whole email and can remove any screenshot or app log attachment before sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se envía nada hasta que tú lo envías. Verás el correo completo y podrás quitar cualquier captura de pantalla o registro de la app antes de enviarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تا زمانی که خودتان نفرستید چیزی ارسال نمی‌شود. کل ایمیل را می‌بینید و می‌توانید پیش از ارسال، هر عکس صفحه یا پیوست گزارش برنامه را حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rien n’est envoyé tant que vous ne l’envoyez pas. Vous verrez l’e-mail complet et pourrez retirer toute capture d’écran ou tout journal de l’app avant l’envoi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "שום דבר אינו נשלח עד שתשלח אותו. תראה את כל תוכן ההודעה ותוכל להסיר כל צילום מסך או יומן אפליקציה לפני השליחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "जब तक आप न भेजें, कुछ भी नहीं भेजा जाता। आप पूरा ईमेल देखेंगे और भेजने से पहले कोई भी स्क्रीनशॉट या ऐप लॉग अटैचमेंट हटा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Semmi nem kerül elküldésre, amíg Ön el nem küldi. Látni fogja a teljes e-mailt, és küldés előtt eltávolíthat bármilyen képernyőkép- vagy naplómellékletet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nic nie zostanie wysłane, dopóki sam tego nie wyślesz. Zobaczysz całą wiadomość i przed wysłaniem możesz usunąć każdy zrzut ekranu oraz załącznik z dziennikiem aplikacji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ничего не отправляется, пока вы не отправите сами. Вы увидите всё письмо и сможете удалить снимок экрана или журнал приложения перед отправкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нічого не надсилається, доки ви не надішлете самі. Ви побачите весь лист і зможете вилучити знімок екрана або журнал застосунку перед надсиланням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你点击发送前，不会发送任何内容。你可以看到完整邮件，并在发送前移除截屏或 App 日志附件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你按下傳送之前不會送出任何內容。你會看到整封郵件，並可在傳送前移除任何螢幕快照或 App 記錄附件。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在你傳送之前，不會傳送任何內容。你可看到完整電郵，並在傳送前移除螢幕快照或 App 記錄附件。"
          }
        }
      }
    },
