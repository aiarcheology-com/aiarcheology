    "alert.history.full.message" : {
      "comment" : "Alert message when browsing history is full",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سجل التصفح ممتلئ. قم بزيادة حجم سجل تصفح الويب في الإعدادات، أو احذف بعض الإدخالات الموجودة من السجل."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ব্রাউজিং ইতিহাস পূর্ণ। সেটিংসে ওয়েব ব্রাউজিং ইতিহাসের আকার বাড়ান, অথবা ইতিহাস থেকে কিছু বিদ্যমান এন্ট্রি মুছুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historie procházení je plná. Zvětšete velikost historie procházení webu v Nastavení nebo smažte některé existující položky z historie."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Browserverlauf ist voll. Erhöhen Sie die Größe des Browserverlaufs in den Einstellungen oder löschen Sie einige vorhandene Einträge."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Browsing history is full. Increase the web browsing history size in Settings, or delete some existing entries from the history."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El historial de navegación está lleno. Aumente el tamaño del historial de navegación web en Configuración o elimine algunas entradas existentes del historial."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تاریخچه مرور پر است. اندازه تاریخچه مرور وب را در تنظیمات افزایش دهید، یا برخی از موارد موجود را از تاریخچه حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'historique de navigation est plein. Augmentez la taille de l'historique de navigation Web dans les Paramètres ou supprimez certaines entrées existantes de l'historique."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היסטוריית הגלישה מלאה. הגדל את גודל היסטוריית הגלישה בהגדרות, או מחק כמה רשומות קיימות מההיסטוריה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ब्राउज़िंग इतिहास भरा हुआ है। सेटिंग्स में वेब ब्राउज़िंग इतिहास का आकार बढ़ाएं, या इतिहास से कुछ मौजूदा प्रविष्टियों को हटाएं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A böngészési előzmények tele vannak. Növelje a böngészési előzmények méretét a Beállításokban, vagy töröljön néhány meglévő bejegyzést az előzményekből."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Historia przeglądania jest pełna. Zwiększ rozmiar historii przeglądania sieci Web w Ustawieniach lub usuń niektóre istniejące wpisy z historii."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "История просмотров заполнена. Увеличьте размер истории просмотров в Настройках или удалите некоторые существующие записи из истории."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Історія перегляду заповнена. Збільште розмір історії перегляду веб-сторінок у Налаштуваннях або видаліть деякі наявні записи з історії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "浏览历史已满。在设置中增加网页浏览历史大小，或删除历史记录中的某些现有条目。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽歷史已滿。在設定中增加網頁瀏覽歷史大小，或刪除歷史記錄中的某些現有項目。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "瀏覽歷史已滿。在設定中增加網頁瀏覽歷史大小，或刪除歷史記錄中的某些現有項目。"
          }
        }
      }
    },
    "alert.restore.message" : {
      "comment" : "Confirmation message when restoring defaults",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيؤدي إعادة تعيين التطبيق إلى مسح جميع نماذج البيانات من ML Browser باستثناء النماذج التجريبية. هل أنت متأكد أنك تريد المتابعة؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ্লিকেশন রিসেট করলে ডেমো মডেল ছাড়া ML Browser থেকে সমস্ত ডেটা মডেল মুছে যাবে। আপনি কি নিশ্চিত যে আপনি এগিয়ে যেতে চান?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetování aplikace vymaže všechny datové modely z ML Browseru kromě demo modelů. Opravdu chcete pokračovat?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Zurücksetzen der Anwendung löscht alle Datenmodelle aus dem ML Browser außer den Demo-Modellen. Möchten Sie fortfahren?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Resetting the application will erase all data models from the ML Browser except the demo models. Are you sure you want to proceed?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Restablecer la aplicación borrará todos los modelos de datos del ML Browser excepto los modelos de demostración. ¿Está seguro de que desea continuar?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بازنشانی برنامه همه مدل‌های داده را از مرورگر ML به جز مدل‌های نمایشی پاک می‌کند. آیا مطمئن هستید که می‌خواهید ادامه دهید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La réinitialisation de l'application effacera tous les modèles de données du ML Browser sauf les modèles de démonstration. Êtes-vous sûr de vouloir continuer ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "איפוס היישום ימחק את כל מודלי הנתונים מדפדפן ML למעט מודלי ההדגמה. האם אתה בטוח שברצונך להמשיך?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन को रीसेट करने से डेमो मॉडल को छोड़कर ML Browser से सभी डेटा मॉडल मिट जाएंगे। क्या आप निश्चित रूप से जारी रखना चाहते हैं?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás visszaállítása törli az összes adatmodellt az ML Browserből, kivéve a demo modelleket. Biztosan folytatni szeretné?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zresetowanie aplikacji spowoduje usunięcie wszystkich modeli danych z ML Browser z wyjątkiem modeli demonstracyjnych. Czy na pewno chcesz kontynuować?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Сброс приложения удалит все модели данных из ML Browser, кроме демонстрационных моделей. Вы уверены, что хотите продолжить?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скидання застосунку видалить усі моделі даних з ML Browser, окрім демонстраційних моделей. Ви впевнені, що хочете продовжити?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置应用程序将从 ML 浏览器中删除除演示模型之外的所有数据模型。您确定要继续吗？"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置應用程式將從 ML 瀏覽器中刪除除示範模型之外的所有資料模型。您確定要繼續嗎？"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "重置應用程式將從 ML 瀏覽器中刪除除示範模型之外的所有資料模型。您確定要繼續嗎？"
          }
        }
      }
    },
