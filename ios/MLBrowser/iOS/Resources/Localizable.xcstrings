    "slideshow.slide3.description" : {
      "comment" : "Slideshow slide 3 description - Add a New Model",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التطبيق قادر على العمل مع نماذج اكتشاف Create ML. انقر على أيقونة المعالج في الزاوية اليسرى العليا، ثم علامة الجمع لإضافة نموذج جديد."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ্লিকেশনটি Create ML ডিটেকশন মডেলের সাথে কাজ করতে সক্ষম। উপরের বাম কোণে প্রসেসর আইকনে ক্লিক করুন, এবং তারপর নতুন মডেল যোগ করতে প্লাস চিহ্নে ক্লিক করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace je schopna pracovat s detekčními modely Create ML. Klikněte na ikonu procesoru v levém horním rohu a poté na znaménko plus pro přidání nového modelu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung kann mit Create ML Erkennungsmodellen arbeiten. Klicken Sie auf das Prozessor-Symbol oben links und dann auf das Pluszeichen, um ein neues Modell hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application is capable of working with Create ML detection models. Click the processor icon in the top left corner, and then plus sign to add a new model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación es capaz de trabajar con modelos de detección Create ML. Haga clic en el icono del procesador en la esquina superior izquierda y luego en el signo más para agregar un nuevo modelo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه قادر به کار با مدل‌های تشخیص Create ML است. روی آیکون پردازنده در گوشه بالا سمت چپ کلیک کنید، سپس علامت مثبت برای افزودن مدل جدید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application est capable de fonctionner avec les modèles de détection Create ML. Cliquez sur l'icône du processeur dans le coin supérieur gauche, puis sur le signe plus pour ajouter un nouveau modèle."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום מסוגל לעבוד עם מודלי זיהוי של Create ML. לחץ על סמל המעבד בפינה השמאלית העליונה, ואז על סימן הפלוס כדי להוסיף מודל חדש."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन Create ML डिटेक्शन मॉडल के साथ काम करने में सक्षम है। ऊपरी बाएं कोने में प्रोसेसर आइकन पर क्लिक करें, और फिर एक नया मॉडल जोड़ने के लिए प्लस चिह्न पर क्लिक करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás képes Create ML észlelési modellekkel dolgozni. Kattintson a processzor ikonra a bal felső sarokban, majd a plusz jelre új modell hozzáadásához."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja jest zdolna do pracy z modelami wykrywania Create ML. Kliknij ikonę procesora w lewym górnym rogu, a następnie znak plus, aby dodać nowy model."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение способно работать с моделями обнаружения Create ML. Щелкните значок процессора в верхнем левом углу, а затем знак плюс, чтобы добавить новую модель."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок здатний працювати з моделями виявлення Create ML. Клацніть значок процесора у верхньому лівому куті, а потім знак плюс, щоб додати нову модель."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该应用可以使用 Create ML 检测模型。点击左上角的处理器图标，然后点击加号添加新模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該應用程式可以使用 Create ML 偵測模型。點按左上角的處理器圖示，然後點按加號加入新模型。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該應用程式可以使用 Create ML 偵測模型。點按左上角的處理器圖示，然後點按加號加入新模型。"
          }
        }
      }
