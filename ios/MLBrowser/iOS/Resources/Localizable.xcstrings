    "about.privacyNotAvailable" : {
      "comment" : "Message when privacy policy is missing",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة الخصوصية غير متوفرة. مفقودة في الحزمة؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "গোপনীয়তা নীতি উপলব্ধ নয়। বান্ডেলে অনুপস্থিত?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
