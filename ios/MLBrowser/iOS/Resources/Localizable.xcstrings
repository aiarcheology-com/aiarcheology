    "settings.reset.removeFindings.message" : {
      "comment" : "Message of the Remove Findings confirmation dialog (AIA-0303)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يؤدي هذا إلى حذف كل اكتشاف محفوظ وصورته نهائيًا. صدّرها أولًا إذا أردت الاحتفاظ بنسخة؛ التصدير لا يحذف شيئًا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি প্রতিটি সংরক্ষিত সন্ধান ও তার ছবি স্থায়ীভাবে মুছে ফেলে। কপি রাখতে চাইলে আগে এক্সপোর্ট করুন — এক্সপোর্ট করলে কিছুই মোছে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trvale se smažou všechny uložené nálezy i jejich fotky. Pokud si chcete kopii ponechat, nejdřív je exportujte — export nic nemaže."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dies löscht dauerhaft jeden gesicherten Fund und sein Foto. Exportieren Sie zuerst, wenn Sie eine Kopie behalten möchten – beim Exportieren wird nichts gelöscht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This permanently deletes every saved finding and its photo. Export first if you want to keep a copy — exporting does not delete anything."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto elimina permanentemente todos los hallazgos guardados y sus fotos. Expórtalos primero si quieres conservar una copia: exportar no elimina nada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این کار هر یافتهٔ ذخیره‌شده و عکس آن را برای همیشه حذف می‌کند. اگر می‌خواهید نسخه‌ای نگه دارید، اول خروجی بگیرید؛ خروجی گرفتن چیزی را حذف نمی‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cette action supprime définitivement chaque découverte enregistrée et sa photo. Exportez-les d’abord si vous souhaitez en garder une copie — l’exportation ne supprime rien."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פעולה זו מוחקת לצמיתות כל ממצא שמור ואת התמונה שלו. ייצא תחילה אם ברצונך לשמור עותק — הייצוא אינו מוחק דבר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इससे हर सहेजी गई खोज और उसकी फ़ोटो हमेशा के लिए डिलीट हो जाएगी। कॉपी रखनी हो तो पहले एक्सपोर्ट करें — एक्सपोर्ट करने से कुछ भी डिलीट नहीं होता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez véglegesen törli az összes mentett leletet és a hozzájuk tartozó fényképeket. Ha meg szeretné őrizni őket, előbb exportálja – az exportálás semmit nem töröl."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Spowoduje to trwałe usunięcie każdego zapisanego znaleziska i jego zdjęcia. Jeśli chcesz zachować kopię, najpierw je wyeksportuj — eksport niczego nie usuwa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это безвозвратно удалит все сохранённые находки и их фотографии. Сначала экспортируйте, если хотите оставить копию — экспорт ничего не удаляет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це безповоротно видалить усі збережені знахідки та їхні фотографії. Спочатку експортуйте, якщо хочете залишити копію — експорт нічого не видаляє."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此操作将永久删除所有已保存的发现记录及其照片。如需保留副本，请先导出，导出不会删除任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這會永久刪除每一項已儲存的發現及其照片。若要保留副本，請先輸出 — 輸出不會刪除任何內容。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此操作會永久刪除所有已儲存的發現記錄及其相片。如需保留副本，請先匯出，匯出不會刪除任何內容。"
          }
        }
      }
    },
