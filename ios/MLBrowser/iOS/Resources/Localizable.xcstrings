    "support.includeApplicationLogExplanation" : {
      "comment" : "Plain-language explanation for the optional application-log attachment in a support email.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "قد يجعل هذا تقريرك أكثر فائدة بكثير. فهو يمنحنا سجلًا موجزًا لما كان التطبيق يفعله قبل المشكلة، مما يساعدنا على إصلاحها أسرع."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এটি আপনার রিপোর্টকে অনেক বেশি কাজে লাগাতে পারে। সমস্যার আগে অ্যাপ কী করছিল তার একটি সংক্ষিপ্ত বিবরণ এটি আমাদের দেয়, যা দ্রুত সমাধানে সাহায্য করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vaše hlášení tím může být mnohem užitečnější. Získáme krátký záznam o tom, co aplikace před problémem dělala, což nám pomůže rychleji ho opravit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das macht Ihren Bericht deutlich nützlicher. Es zeigt uns kurz, was die App vor dem Problem getan hat, und hilft uns, es schneller zu beheben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This can make your report much more useful. It gives us a short record of what the app was doing before the problem, which can help us fix it faster."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esto puede hacer que tu informe sea mucho más útil. Nos ofrece un breve registro de lo que estaba haciendo la app antes del problema, lo que nos ayuda a solucionarlo más rápido."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این می‌تواند گزارش شما را بسیار مفیدتر کند. سابقهٔ کوتاهی از کاری که برنامه پیش از بروز مشکل انجام می‌داد به ما می‌دهد و کمک می‌کند سریع‌تر آن را رفع کنیم."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cela peut rendre votre rapport bien plus utile. Il nous donne un bref historique de ce que faisait l’app avant le problème, ce qui nous aide à le corriger plus vite."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "זה יכול להפוך את הדיווח שלך לשימושי הרבה יותר. היומן מספק לנו תיעוד קצר של מה שהאפליקציה עשתה לפני הבעיה, וזה יכול לעזור לנו לתקן אותה מהר יותר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इससे आपकी रिपोर्ट कहीं ज़्यादा उपयोगी हो सकती है। यह हमें बताता है कि समस्या से पहले ऐप क्या कर रहा था, जिससे हम इसे तेज़ी से ठीक कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ez sokkal hasznosabbá teheti a jelentést. Rövid feljegyzést ad arról, mit csinált az alkalmazás a hiba előtt, így gyorsabban javíthatjuk."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "To może znacznie zwiększyć przydatność zgłoszenia. Daje nam krótki zapis tego, co aplikacja robiła przed wystąpieniem problemu, co pomoże go szybciej naprawić."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Это может сделать ваше обращение гораздо полезнее. Журнал даёт краткую запись того, что приложение делало до возникновения проблемы, и помогает исправить её быстрее."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Це може зробити ваше звернення значно кориснішим. Журнал дає короткий запис того, що застосунок робив до появи проблеми, і допомагає виправити її швидше."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "这会让你的报告更有价值。它记录了问题发生前 App 的简要运行情况，有助于我们更快修复。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這能讓你的報告更有幫助。它提供我們一份簡短的紀錄，說明問題發生前 App 正在做什麼，有助於我們更快修正。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "這會令你的報告更有用。它記錄了問題發生前 App 的簡要運行情況，有助我們更快修正。"
          }
        }
      }
    },
    "support.mailUnavailable.message" : {
      "comment" : "Shown when the mail composer is unavailable but a default mail app opened via mailto. %@ is the support email address.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فتحنا تطبيق البريد الافتراضي لديك بدلًا من ذلك، ولا يمكن إضافة مرفقات بهذه الطريقة. إذا ظهر أنه لا يوجد حساب مُعد، فأضف حسابًا من الإعدادات ← البريد ← حسابات البريد. يمكنك أيضًا نسخ التقرير وإرساله إلى %@ من أي مكان."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আমরা বদলে আপনার ডিফল্ট মেল অ্যাপ খুলেছি — সেভাবে অ্যাটাচমেন্ট যোগ করা যায় না। যদি বলে কোনো অ্যাকাউন্ট সেট করা নেই, তাহলে সেটিংস → Mail → Mail অ্যাকাউন্ট-এ একটি যোগ করুন। আপনি রিপোর্টটি কপি করে যেকোনো জায়গা থেকে %@ ঠিকানায় পাঠাতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otevřeli jsme místo toho vaši výchozí poštovní aplikaci — tam nelze přidat přílohy. Pokud hlásí, že není nastaven žádný účet, přidejte ho v Nastavení → Mail → Účty. Hlášení můžete také zkopírovat a odeslat odkudkoli na %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wir haben stattdessen Ihre Standard-Mail-App geöffnet – auf diesem Weg lassen sich keine Anhänge hinzufügen. Falls dort kein Account eingerichtet ist, fügen Sie einen unter Einstellungen → Mail → Accounts hinzu. Sie können den Bericht auch kopieren und von überall an %@ senden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "We opened your default mail app instead — attachments cannot be added that way. If it says no account is set up, add one in Settings → Mail → Mail Accounts. You can also copy the report and send it to %@ from anywhere."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hemos abierto tu app de correo por omisión: así no se pueden añadir archivos adjuntos. Si indica que no hay ninguna cuenta configurada, añade una en Ajustes → Mail → Cuentas de Mail. También puedes copiar el informe y enviarlo a %@ desde donde quieras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "به‌جای آن، برنامهٔ ایمیل پیش‌فرض شما را باز کردیم؛ به این روش نمی‌توان پیوست اضافه کرد. اگر می‌گوید هیچ حسابی تنظیم نشده، از تنظیمات ← ایمیل ← حساب‌های ایمیل یکی اضافه کنید. همچنین می‌توانید گزارش را کپی کنید و از هر جایی به %@ بفرستید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nous avons ouvert votre app de mail par défaut — les pièces jointes ne peuvent pas être ajoutées ainsi. Si elle indique qu’aucun compte n’est configuré, ajoutez-en un dans Réglages → Mail → Comptes Mail. Vous pouvez aussi copier le rapport et l’envoyer à %@ depuis n’importe où."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פתחנו במקום זאת את אפליקציית הדואר שמוגדרת כברירת מחדל — לא ניתן לצרף קבצים בדרך זו. אם מופיעה הודעה שלא הוגדר חשבון, הוסף חשבון בהגדרות > דואר > חשבונות דואר. אפשר גם להעתיק את הדוח ולשלוח אותו אל %@ מכל מקום."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "हमने इसके बजाय आपका डिफ़ॉल्ट मेल ऐप खोला — उस तरीके से अटैचमेंट नहीं जोड़े जा सकते। अगर यह कहे कि कोई अकाउंट सेट नहीं है, तो सेटिंग्ज़ → Mail → Mail अकाउंट में एक जोड़ें। आप रिपोर्ट कॉपी करके कहीं से भी %@ पर भेज सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Helyette az alapértelmezett levelezőalkalmazást nyitottuk meg – így nem lehet mellékletet hozzáadni. Ha azt jelzi, hogy nincs beállítva fiók, adjon hozzá egyet a Beállítások → Mail → Fiókok menüben. A jelentést ki is másolhatja, és bárhonnan elküldheti ide: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Otworzyliśmy zamiast tego twoją domyślną aplikację pocztową — w ten sposób nie można dodać załączników. Jeśli pojawi się komunikat o braku konta, dodaj je w Ustawienia → Mail → Konta. Możesz też skopiować raport i wysłać go na %@ z dowolnego miejsca."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Мы открыли ваше почтовое приложение по умолчанию — вложения так добавить нельзя. Если оно сообщает, что учётная запись не настроена, добавьте её в «Настройки» → «Почта» → «Учётные записи». Также можно скопировать отчёт и отправить его на %@ откуда угодно."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ми відкрили ваш типовий поштовий застосунок — вкладення так додати не можна. Якщо він повідомляє, що обліковий запис не налаштовано, додайте його в «Налаштування» → «Пошта» → «Облікові записи». Також можна скопіювати звіт і надіслати його на %@ звідки завгодно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我们改为打开了你的默认邮件 App，这种方式无法添加附件。如果提示未设置账户，请在“设置”→“邮件”→“邮件账户”中添加。你也可以复制报告，从任意位置发送至 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我們改為打開你的預設郵件 App — 這種方式無法加入附件。若顯示尚未設定帳號，請前往「設定」>「郵件」>「郵件帳號」加入帳號。你也可以拷貝報告，從任何地方寄到 %@。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "我們改為開啟了你的預設郵件 App，這種方式無法加入附件。如顯示未設定帳戶，請在「設定」→「郵件」→「郵件帳戶」中加入。你亦可拷貝報告，從任何地方傳送至 %@。"
          }
        }
      }
    },
    "support.mailUnavailable.messageNoMailApp" : {
      "comment" : "Shown when no mail app could be opened at all. %@ is the support email address.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر فتح أي تطبيق بريد. أضف حساب بريد إلكتروني من الإعدادات ← البريد ← حسابات البريد، أو انسخ التقرير وأرسله إلى %@ من جهاز آخر."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কোনো মেল অ্যাপ খোলা যায়নি। সেটিংস → Mail → Mail অ্যাকাউন্ট-এ একটি ইমেল অ্যাকাউন্ট যোগ করুন, অথবা রিপোর্টটি কপি করে অন্য ডিভাইস থেকে %@ ঠিকানায় পাঠান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nepodařilo se otevřít žádnou poštovní aplikaci. Přidejte e-mailový účet v Nastavení → Mail → Účty, nebo hlášení zkopírujte a odešlete z jiného zařízení na %@."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Es konnte keine Mail-App geöffnet werden. Fügen Sie unter Einstellungen → Mail → Accounts einen E-Mail-Account hinzu oder kopieren Sie den Bericht und senden Sie ihn von einem anderen Gerät an %@."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No mail app could be opened. Add an email account in Settings → Mail → Mail Accounts, or copy the report and send it to %@ from another device."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo abrir ninguna app de correo. Añade una cuenta de correo en Ajustes → Mail → Cuentas de Mail, o copia el informe y envíalo a %@ desde otro dispositivo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "هیچ برنامهٔ ایمیلی باز نشد. از تنظیمات ← ایمیل ← حساب‌های ایمیل یک حساب ایمیل اضافه کنید، یا گزارش را کپی کنید و از دستگاهی دیگر به %@ بفرستید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucune app de mail n’a pu être ouverte. Ajoutez un compte de messagerie dans Réglages → Mail → Comptes Mail, ou copiez le rapport et envoyez-le à %@ depuis un autre appareil."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן היה לפתוח אף אפליקציית דואר. הוסף חשבון דוא״ל בהגדרות > דואר > חשבונות דואר, או העתק את הדוח ושלח אותו אל %@ ממכשיר אחר."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "कोई मेल ऐप नहीं खुल सका। सेटिंग्ज़ → Mail → Mail अकाउंट में एक ईमेल अकाउंट जोड़ें, या रिपोर्ट कॉपी करके किसी दूसरे डिवाइस से %@ पर भेजें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egyetlen levelezőalkalmazást sem sikerült megnyitni. Adjon hozzá egy e-mail-fiókot a Beállítások → Mail → Fiókok menüben, vagy másolja ki a jelentést, és küldje el egy másik eszközről ide: %@."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się otworzyć żadnej aplikacji pocztowej. Dodaj konto e-mail w Ustawienia → Mail → Konta albo skopiuj raport i wyślij go na %@ z innego urządzenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось открыть ни одно почтовое приложение. Добавьте учётную запись почты в «Настройки» → «Почта» → «Учётные записи» или скопируйте отчёт и отправьте его на %@ с другого устройства."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося відкрити жодного поштового застосунку. Додайте обліковий запис пошти в «Налаштування» → «Пошта» → «Облікові записи» або скопіюйте звіт і надішліть його на %@ з іншого пристрою."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法打开任何邮件 App。请在“设置”→“邮件”→“邮件账户”中添加电子邮件账户，或复制报告并从其他设备发送至 %@。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法打開任何郵件 App。請前往「設定」>「郵件」>「郵件帳號」加入電子郵件帳號，或拷貝報告並從其他裝置寄到 %@。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法開啟任何郵件 App。請在「設定」→「郵件」→「郵件帳戶」中加入電郵帳戶，或拷貝報告並從其他裝置傳送至 %@。"
          }
        }
      }
    },
