    "slideshow.slide1.description" : {
      "comment" : "Slideshow slide 1 description - Open a Web Page",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يمكنك فتح أي صفحة ويب، على غرار الطريقة التي تستخدمها في متصفح الويب، مع المحتوى الذي ترغب في اختباره باستخدام نموذج الكشف عن الكائنات الخاص بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "আপনি যে কোনো ওয়েব পেজ খুলতে পারেন, ঠিক যেভাবে আপনি একটি ওয়েব ব্রাউজারে খুলবেন, যে কন্টেন্ট আপনি আপনার অবজেক্ট ডিটেকশন মডেল ব্যবহার করে পরীক্ষা করতে চান।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Můžete otevřít jakoukoli webovou stránku podobně jako v webovém prohlížeči s obsahem, který chcete otestovat pomocí svého detekčního modelu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jede Webseite öffnen, ähnlich wie in einem Webbrowser, mit Inhalten, die Sie mit Ihrem Objekterkennungsmodell testen möchten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can open any web page, similar to how you would in a web browser, with content you wish to test using your object detection model."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puede abrir cualquier página web, de manera similar a como lo haría en un navegador web, con contenido que desee probar usando su modelo de detección de objetos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "می‌توانید هر صفحه وب را باز کنید، مشابه مرورگر وب، با محتوایی که می‌خواهید با مدل تشخیص اشیاء خود آزمایش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez ouvrir n'importe quelle page Web, de la même manière que dans un navigateur Web, avec du contenu que vous souhaitez tester à l'aide de votre modèle de détection d'objets."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "אתה יכול לפתוח כל דף אינטרנט, בדומה לאופן שבו היית עושה בדפדפן אינטרנט, עם תוכן שברצונך לבדוק באמצעות מודל זיהוי האובייקטים שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "आप किसी भी वेब पेज को खोल सकते हैं, जैसे कि आप वेब ब्राउज़र में करते हैं, उस सामग्री के साथ जिसे आप अपने ऑब्जेक्ट डिटेक्शन मॉडल का उपयोग करके परीक्षण करना चाहते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bármelyik weboldalt megnyithatja, hasonlóan ahhoz, ahogy egy webböngészőben tenné, olyan tartalommal, amelyet az objektumfelismerő modelljével szeretne tesztelni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Możesz otworzyć dowolną stronę internetową, podobnie jak w przeglądarce internetowej, z treścią, którą chcesz przetestować przy użyciu modelu wykrywania obiektów."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы можете открыть любую веб-страницу, аналогично тому, как вы делаете это в веб-браузере, с содержимым, которое вы хотите протестировать с помощью вашей модели обнаружения объектов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ви можете відкрити будь-яку веб-сторінку, подібно до того, як ви робите це у веб-браузері, зі вмістом, який ви хочете перевірити за допомогою вашої моделі виявлення об'єктів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以打开任何网页，就像在网页浏览器中一样，使用您想要测试的内容和对象检测模型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以開啟任何網頁，就像在網頁瀏覽器中一樣，使用您想要測試的內容和物件偵測模型。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您可以開啟任何網頁，就像在網頁瀏覽器中一樣，使用您想要測試的內容和物件偵測模型。"
          }
        }
      }
    },
