    "support.body.detailsHeader" : {
      "comment" : "Header above the technical details block in the support email body.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تفاصيل تقنية تساعدنا في تحديد المشكلة. يمكنك تعديل أي شيء أدناه أو إزالته قبل الإرسال."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কারিগরি বিবরণ — এগুলি আমাদের সমস্যা খুঁজে পেতে সাহায্য করে। পাঠানোর আগে আপনি নিচের যেকোনো কিছু বদলাতে বা সরিয়ে দিতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Technické údaje — pomohou nám problém najít. Před odesláním můžete cokoli níže upravit nebo odstranit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Technische Details – sie helfen uns, das Problem zu finden. Sie können alles Folgende vor dem Senden bearbeiten oder entfernen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Technical details — these help us find the problem. You can edit or remove anything below before sending."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Detalles técnicos: nos ayudan a encontrar el problema. Puedes editar o eliminar cualquier dato de los siguientes antes de enviarlo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "جزئیات فنی که به یافتن مشکل کمک می‌کند. می‌توانید پیش از ارسال، هر چیزی را در پایین ویرایش یا حذف کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Détails techniques — ils nous aident à trouver le problème. Vous pouvez modifier ou supprimer ce qui suit avant l’envoi."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "פרטים טכניים — הם עוזרים לנו לאתר את הבעיה. אפשר לערוך או להסיר כל דבר שמופיע למטה לפני השליחה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "तकनीकी विवरण — ये हमें समस्या ढूँढने में मदद करते हैं। भेजने से पहले आप नीचे कुछ भी बदल या हटा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Technikai részletek – ezek segítenek megtalálni a hibát. Küldés előtt bármit szerkeszthet vagy eltávolíthat az alábbiakból."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Szczegóły techniczne — pomagają nam znaleźć problem. Przed wysłaniem możesz edytować lub usunąć dowolną część poniżej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Технические сведения — они помогают нам найти проблему. Вы можете изменить или удалить всё ниже перед отправкой."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Технічні відомості — вони допомагають нам знайти проблему. Ви можете змінити або видалити будь-що нижче перед надсиланням."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "技术细节：这些信息有助于我们定位问题。发送前你可以编辑或删除以下任何内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "技術細節 — 這些有助於我們找出問題。你可以在傳送前編輯或移除以下任何內容。"
          }
