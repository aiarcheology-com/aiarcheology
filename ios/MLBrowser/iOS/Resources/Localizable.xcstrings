    "paywall.pitch" : {
      "comment" : "Paywall description for a user who did not lose a free window — the Settings sheet, or a build that never granted one.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اشترك لمواصلة استخدام ML Browser والحصول على جميع التحديثات والتحسينات المستقبلية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ML Browser ব্যবহার চালিয়ে যেতে এবং ভবিষ্যতের সব আপডেট ও উন্নতি পেতে সাবস্ক্রাইব করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Objednejte si předplatné, abyste mohli ML Browser dál používat a dostávat všechny budoucí aktualizace a vylepšení."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abonnieren Sie, um ML Browser weiterhin zu nutzen und alle künftigen Updates und Verbesserungen zu erhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Subscribe to keep using ML Browser and receive all future updates and improvements."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Suscríbete para seguir usando ML Browser y recibir todas las futuras actualizaciones y mejoras."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برای ادامهٔ استفاده از ML Browser و دریافت همهٔ به‌روزرسانی‌ها و بهبودهای آینده مشترک شوید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Abonnez-vous pour continuer à utiliser ML Browser et recevoir toutes les futures mises à jour et améliorations."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "יש להירשם למינוי כדי להמשיך להשתמש ב-ML Browser ולקבל את כל העדכונים והשיפורים העתידיים."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ML Browser का उपयोग जारी रखने और भविष्य के सभी अपडेट व सुधार पाने के लिए सब्सक्राइब करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Fizessen elő az ML Browser további használatához, és megkapja az összes jövőbeli frissítést és fejlesztést."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wykup subskrypcję, aby dalej korzystać z aplikacji ML Browser i otrzymywać wszystkie przyszłe aktualizacje i ulepszenia."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оформите подписку, чтобы продолжить пользоваться ML Browser и получать все будущие обновления и улучшения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Оформіть передплату, щоб продовжити користуватися ML Browser і отримувати всі майбутні оновлення та вдосконалення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "订阅即可继续使用 ML Browser，并获得日后的所有更新和改进。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "訂閱即可繼續使用 ML Browser，並取得日後所有的更新與改進。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "訂閱即可繼續使用 ML Browser，並取得日後所有更新及改良。"
          }
        }
      }
    },
