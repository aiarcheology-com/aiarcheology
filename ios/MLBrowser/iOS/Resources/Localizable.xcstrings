    "slideshow.slide5.description" : {
      "comment" : "Slideshow slide 5 description - Activate Models",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في هذه القائمة على اليسار، يمكنك تنشيط أي نموذج للكشف. تعمل هذه الكاشفات في وقت واحد على نفس محتوى صفحة الويب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "বাম দিকের এই মেনুতে, আপনি যে কোনো ডিটেকশন মডেল সক্রিয় করতে পারেন। এই ডিটেক্টরগুলি একই ওয়েব পেজ কন্টেন্টে একসাথে কাজ করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V této nabídce vlevo můžete aktivovat jakýkoli detekční model. Tyto detektory pracují současně na stejném obsahu webové stránky."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Menü auf der linken Seite können Sie jedes Erkennungsmodell aktivieren. Diese Detektoren arbeiten gleichzeitig auf demselben Webseiteninhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this menu on the left, you can activate any detection model. These detectors work simultaneously on the same web page content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En este menú de la izquierda, puede activar cualquier modelo de detección. Estos detectores funcionan simultáneamente en el mismo contenido de la página web."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در این منو در سمت چپ، می‌توانید هر مدل تشخیص را فعال کنید. این تشخیص‌دهنده‌ها به طور همزمان روی همان محتوای صفحه وب کار می‌کنند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans ce menu à gauche, vous pouvez activer n'importe quel modèle de détection. Ces détecteurs fonctionnent simultanément sur le même contenu de page Web."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בתפריט זה משמאל, אתה יכול להפעיל כל מודל זיהוי. גלאים אלה עובדים בו-זמנית על אותו תוכן דף אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "बाईं ओर इस मेनू में, आप किसी भी डिटेक्शन मॉडल को सक्रिय कर सकते हैं। ये डिटेक्टर एक ही वेब पेज सामग्री पर एक साथ काम करते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a bal oldali menüben bármilyen felismerő modellt aktiválhat. Ezek a detektorok egyidejűleg működnek ugyanazon a weboldalon."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W tym menu po lewej stronie możesz aktywować dowolny model wykrywania. Te detektory działają jednocześnie na tej samej zawartości strony internetowej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В этом меню слева вы можете активировать любую модель обнаружения. Эти детекторы работают одновременно с одним и тем же содержимым веб-страницы."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У цьому меню ліворуч ви можете активувати будь-яку модель виявлення. Ці детектори працюють одночасно з одним і тим же вмістом веб-сторінки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
