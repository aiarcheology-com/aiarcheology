    "findings.empty.message" : {
      "comment" : "Empty-state message of the findings inventory",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم زر البحث، ثم المس المكان في محتوى الويب لحفظه هنا."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "খুঁজুন বোতামটি ব্যবহার করুন, তারপর ওয়েব কনটেন্টে যে জায়গাটি এখানে রাখতে চান সেখানে ট্যাপ করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použijte tlačítko Najít a pak klepněte na místo ve webovém obsahu, které chcete uložit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippen Sie auf die Fund-Taste und dann auf die Stelle im Webinhalt, um sie hier zu sichern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use the Find button, then tap the place in the web content to store it here."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usa el botón Buscar y luego toca el lugar del contenido web para guardarlo aquí."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "از دکمهٔ یافتن استفاده کنید، سپس روی جای موردنظر در محتوای وب ضربه بزنید تا اینجا ذخیره شود."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Utilisez le bouton Trouver, puis touchez l’endroit dans le contenu web pour l’enregistrer ici."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השתמש בכפתור ״מצא״, ולאחר מכן הקש על המקום בתוכן האינטרנט כדי לשמור אותו כאן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "खोज बटन का उपयोग करें, फिर वेब सामग्री में उस जगह पर टैप करें जिसे यहाँ सहेजना है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Koppintson a lelet gombra, majd a webes tartalomban arra a helyre, amelyet ide szeretne menteni."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj przycisku Znajdź, a następnie stuknij miejsce w treści strony, aby je tutaj zapisać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Нажмите кнопку «Найти», затем коснитесь места на странице, чтобы сохранить его здесь."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Натисніть кнопку «Знайти», потім торкніться місця на сторінці, щоб зберегти його тут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用“查找”按钮，然后轻点网页内容中的位置，即可保存到这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用「尋找」按鈕，然後輕點網頁內容中的位置，即可儲存到這裡。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "使用「尋找」按鈕，然後輕按網頁內容中的位置，即可儲存到這裡。"
          }
        }
      }
    },
