    "slideshow.slide3.description" : {
      "comment" : "Slideshow slide 3 description - Add a New Model",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung kann mit Create ML Erkennungsmodellen arbeiten. Klicken Sie auf das Prozessor-Symbol oben links und dann auf das Pluszeichen, um ein neues Modell hinzuzufügen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application is capable of working with Create ML detection models. Click the processor icon in the top left corner, and then plus sign to add a new model."
          }
        }
      }
    },
    "slideshow.slide3.title" : {
      "comment" : "Slideshow slide 3 title - Add a New Model",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein neues Modell hinzufügen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Add a New Model"
          }
        }
      }
    },
    "slideshow.slide4.description" : {
      "comment" : "Slideshow slide 4 description - Open or download model",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sie können jedes Create ML Erkennungsmodell auf Ihr Apple-Gerät herunterladen und in die ML Browser App laden. Der ML Browser sendet Ihr Modell nirgendwohin und sammelt keine Informationen. Das Modell wird nur für die Annotationen verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "You can download any Create ML detection model to your Apple device and load it into the ML Browser app. The ML Browser does not send your model anywhere, or collect information. The model is used only for the annotations."
          }
        }
      }
    },
    "slideshow.slide4.title" : {
      "comment" : "Slideshow slide 4 title - Open or download model",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Modell vom Gerät öffnen oder herunterladen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Open the Model from the device, or download it."
          }
        }
      }
    },
    "slideshow.slide5.description" : {
      "comment" : "Slideshow slide 5 description - Activate Models",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In diesem Menü auf der linken Seite können Sie jedes Erkennungsmodell aktivieren. Diese Detektoren arbeiten gleichzeitig auf demselben Webseiteninhalt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In this menu on the left, you can activate any detection model. These detectors work simultaneously on the same web page content."
          }
        }
      }
    },
    "slideshow.slide5.title" : {
      "comment" : "Slideshow slide 5 title - Activate Models",
