    "slideshow.slide9.description" : {
      "comment" : "Slideshow slide 9 description - Annotation",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الآن، يمكنك تصفح محتوى الويب المفضل لديك والبحث عن الميزات التي قد يتعرف عليها نموذج الكشف الخاص بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এখন, আপনি আপনার প্রিয় ওয়েব কন্টেন্ট ব্রাউজ করতে পারেন এবং এমন বৈশিষ্ট্যগুলি সন্ধান করতে পারেন যা আপনার ডিটেকশন মডেল চিনতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyní můžete procházet svůj oblíbený webový obsah a hledat funkce, které by váš detekční model mohl rozpoznat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jetzt können Sie Ihre bevorzugten Webinhalte durchsuchen und nach Merkmalen suchen, die Ihr Erkennungsmodell möglicherweise erkennt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now, you can browse your favorite web content and look for features that your detection model might recognize."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora, puede navegar por su contenido web favorito y buscar funciones que su modelo de detección pueda reconocer."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اکنون می‌توانید محتوای وب مورد علاقه خود را مرور کنید و به دنبال ویژگی‌هایی بگردید که مدل تشخیص شما ممکن است شناسایی کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maintenant, vous pouvez parcourir votre contenu Web préféré et rechercher des fonctionnalités que votre modèle de détection pourrait reconnaître."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "עכשיו, אתה יכול לגלוש בתוכן האינטרנט האהוב עליך ולחפש תכונות שמודל הזיהוי שלך עשוי לזהות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "अब, आप अपनी पसंदीदा वेब सामग्री ब्राउज़ कर सकते हैं और उन सुविधाओं को खोज सकते हैं जिन्हें आपका डिटेक्शन मॉडल पहचान सकता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most már böngészheti kedvenc webes tartalmát, és keresheti azokat a funkciókat, amelyeket az észlelő modellje felismerhet."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Teraz możesz przeglądać ulubioną zawartość internetową i szukać funkcji, które Twój model wykrywania może rozpoznać."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Теперь вы можете просматривать свой любимый веб-контент и искать функции, которые может распознать ваша модель обнаружения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Тепер ви можете переглядати свій улюблений веб-вміст і шукати функції, які може розпізнати ваша модель виявлення."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在，您可以浏览您喜欢的网页内容并寻找您的检测模型可能识别的特征。"
          }
        },
        "zh-Hant" : {
