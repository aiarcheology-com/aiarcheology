    "browser.location.dataSheet.description" : {
      "comment" : "Explains what the Delete Cookies button removes (one website)",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يزيل ملفات تعريف الارتباط وذاكرات التخزين المؤقت والبيانات الأخرى التي خزّنها هذا الموقع. قد تُسجّل صفحاته خروجك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই ওয়েবসাইটের সংরক্ষিত কুকি, ক্যাশে ও অন্যান্য ডেটা সরিয়ে দেয়। এর পেজগুলি আপনাকে সাইন আউট করে দিতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Odstraní cookies, mezipaměti a další data uložená tímto webem. Jeho stránky vás mohou odhlásit."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Entfernt Cookies, Caches und andere von dieser Website gespeicherte Daten. Ihre Seiten melden Sie möglicherweise ab."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Removes cookies, caches and other data stored by this website. Its pages may sign you out."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elimina las cookies, las cachés y otros datos guardados por este sitio web. Es posible que sus páginas cierren tu sesión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "کوکی‌ها، حافظه‌های نهان و دیگر داده‌های ذخیره‌شده توسط این وب‌سایت را پاک می‌کند. ممکن است صفحه‌های آن شما را از حساب خارج کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprime les cookies, les caches et les autres données enregistrées par ce site. Ses pages peuvent vous déconnecter."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מסיר עוגיות, מטמון ונתונים אחרים שהאתר הזה שמר. ייתכן שתנותק מהעמודים שלו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस वेबसाइट द्वारा सहेजी गई कुकीज़, कैश और अन्य डेटा हटाता है। इसके पेज आपको साइन आउट कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Törli a webhely által tárolt sütiket, gyorsítótárakat és egyéb adatokat. Az oldalai kijelentkeztethetik Önt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Usuwa ciasteczka, pamięci podręczne i inne dane zapisane przez tę witrynę. Jej strony mogą cię wylogować."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Удаляет cookie, кэш и другие данные, сохранённые этим сайтом. На его страницах может произойти выход из аккаунта."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Видаляє cookie, кеш та інші дані, збережені цим сайтом. На його сторінках може статися вихід з облікового запису."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移除此网站存储的 Cookie、缓存和其他数据。其页面可能会将你退出登录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移除此網站儲存的 Cookie、快取和其他資料。其頁面可能會將你登出。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "移除此網站儲存的 Cookie、快取及其他資料。其頁面可能會將你登出。"
          }
        }
      }
    },
