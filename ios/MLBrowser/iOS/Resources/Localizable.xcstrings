    "import.resumeConversionMessage" : {
      "comment" : "Explains that a native conversion stopped before registration and can be resumed or discarded",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لم يكتمل تحويل نموذج أصلي. يمكنك استئنافه، أو فحص سجل التحويل الخالي من المسارات، أو تجاهل الملفات المؤقتة في مساحة التطبيق."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "একটি মডেল রূপান্তর শেষ হয়নি। আপনি এটি আবার শুরু করতে পারেন, এর রূপান্তর লগ দেখতে পারেন, বা এর অস্থায়ী ফাইলগুলি সরিয়ে দিতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Převod nativního modelu se nedokončil. Můžete v něm pokračovat, prohlédnout si protokol převodu bez cest, nebo zahodit připravené soubory."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eine native Modellkonvertierung wurde nicht abgeschlossen. Sie können sie fortsetzen, ihr pfadfreies Konvertierungsprotokoll ansehen oder ihre zwischengespeicherten Artefakte verwerfen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A native model conversion did not finish. You can resume it, inspect its path-free conversion log, or discard its staged app-sandbox artifacts."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Una conversión de modelo nativo no finalizó. Puedes reanudarla, consultar su registro de conversión sin rutas o descartar sus archivos intermedios del entorno aislado de la app."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تبدیل یک مدل بومی کامل نشد. می‌توانید آن را از سر بگیرید، گزارش تبدیل بدون مسیر آن را ببینید، یا فایل‌های موقت آن را در فضای برنامه دور بیندازید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Une conversion de modèle natif ne s’est pas terminée. Vous pouvez la reprendre, consulter son journal de conversion sans chemins d’accès, ou supprimer ses fichiers intermédiaires dans le bac à sable de l’app."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "המרת מודל מקורי לא הסתיימה. אפשר לחדש אותה, לעיין ביומן ההמרה שלה, או למחוק את הקבצים הזמניים שלה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "एक मॉडल कन्वर्ज़न पूरा नहीं हुआ। आप इसे फिर से शुरू कर सकते हैं, इसका कन्वर्ज़न लॉग देख सकते हैं, या इसकी अस्थायी फ़ाइलें हटा सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Egy natív modellkonverzió nem fejeződött be. Folytathatja, megtekintheti az útvonalmentes konverziós naplót, vagy elvetheti az előkészített ideiglenes fájlokat."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Konwersja modelu natywnego nie zakończyła się. Możesz ją wznowić, przejrzeć dziennik konwersji bez ścieżek albo odrzucić przygotowane pliki."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Конвертация нативной модели не завершилась. Её можно возобновить, посмотреть журнал конвертации без путей или удалить промежуточные файлы в песочнице приложения."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Конвертація нативної моделі не завершилася. Її можна відновити, переглянути журнал конвертації без шляхів або видалити проміжні файли в пісочниці застосунку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有一项原生模型转换尚未完成。你可以继续转换、查看不含路径的转换日志，或放弃其暂存在 App 沙盒中的中间文件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "原生模型轉換尚未完成。你可以繼續轉換、查看其轉換紀錄，或捨棄暫存的檔案。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "有一項原生模型轉換尚未完成。你可以繼續轉換、查看不含路徑的轉換記錄，或捨棄暫存於 App 沙盒中的中間檔案。"
          }
        }
      }
    },
