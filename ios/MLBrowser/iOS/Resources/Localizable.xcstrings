    "support.sendUnredactedDataExplanation" : {
      "comment" : "Plain-language consent explanation for sending the unredacted application log.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "استخدم هذا فقط إذا كنت مرتاحًا لمشاركة التفاصيل التقنية الكاملة. فقد تتضمن عناوين ويب كاملة ومعرّفات ومعلومات الموقع، مما قد يساعدنا على إعادة إنتاج المشكلة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "সম্পূর্ণ কারিগরি বিবরণ শেয়ার করতে স্বচ্ছন্দ হলেই কেবল এটি ব্যবহার করুন। এতে সম্পূর্ণ ওয়েব ঠিকানা, ID ও অবস্থানের তথ্য থাকতে পারে, যা সমস্যাটি আবার তৈরি করতে আমাদের সাহায্য করতে পারে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Použijte to jen tehdy, pokud jste ochotni sdílet úplné technické údaje. Mohou obsahovat celé webové adresy, identifikátory a údaje o poloze, které nám mohou pomoci problém zreprodukovat."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nutzen Sie dies nur, wenn Sie mit der Weitergabe aller technischen Details einverstanden sind. Sie können vollständige Webadressen, IDs und Standortangaben enthalten, die uns helfen, das Problem nachzuvollziehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use this only if you are comfortable sharing the full technical details. It can include complete web addresses, IDs and location information, which may help us reproduce the problem."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Actívalo solo si te parece bien compartir todos los detalles técnicos. Pueden incluir direcciones web completas, identificadores e información de ubicación, lo que puede ayudarnos a reproducir el problema."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "فقط در صورتی از این استفاده کنید که با به اشتراک گذاشتن همهٔ جزئیات فنی راحت هستید. ممکن است شامل نشانی‌های کامل وب، شناسه‌ها و اطلاعات مکانی باشد که به بازتولید مشکل کمک می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "N’activez cette option que si vous acceptez de partager tous les détails techniques. Ils peuvent inclure des adresses web complètes, des identifiants et des informations de localisation, ce qui peut nous aider à reproduire le problème."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "השתמש באפשרות זו רק אם אין לך בעיה לשתף את כל הפרטים הטכניים. היא עשויה לכלול כתובות אינטרנט מלאות, מזהים ומידע מיקום, שיכולים לעזור לנו לשחזר את הבעיה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इसका उपयोग तभी करें जब आप पूरे तकनीकी विवरण शेयर करने में सहज हों। इसमें पूरे वेब पते, ID और स्थान की जानकारी हो सकती है, जो समस्या दोहराने में हमारी मदद कर सकती है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Csak akkor használja, ha vállalja a teljes technikai részletek megosztását. Tartalmazhat teljes webcímeket, azonosítókat és helyadatokat, amelyek segíthetnek a hiba reprodukálásában."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Użyj tego tylko wtedy, gdy nie masz nic przeciwko udostępnieniu pełnych szczegółów technicznych. Mogą one zawierać pełne adresy internetowe, identyfikatory i informacje o lokalizacji, które pomogą nam odtworzyć problem."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Включайте это, только если готовы поделиться полными техническими сведениями. В них могут быть полные веб-адреса, идентификаторы и данные о местоположении, которые помогут воспроизвести проблему."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Вмикайте це, лише якщо готові поділитися повними технічними відомостями. У них можуть бути повні веб-адреси, ідентифікатори та дані про місцеперебування, які допоможуть відтворити проблему."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "仅在你愿意共享完整技术细节时使用。其中可能包含完整网址、标识符和位置信息，这有助于我们重现问题。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "只有在你願意分享完整技術細節時才使用此選項。其中可能包含完整網址、ID 和位置資訊，這些有助於我們重現問題。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "僅在你願意分享完整技術細節時使用。當中可能包含完整網址、識別碼及位置資料，有助我們重現問題。"
          }
        }
      }
    },
