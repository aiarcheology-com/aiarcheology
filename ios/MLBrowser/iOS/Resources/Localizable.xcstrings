    "settings.subscription.freeAccessFootnoteWithTrial" : {
      "comment" : "Settings footer under the ML Browser section while app-managed free access is running and this Apple Account still qualifies for the introductory trial. %1$@ is the date free access ends, %2$@ the trial length. Replaces settings.subscription.freeAccessFootnote, whose wording implied the two free periods stack — they do not.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "مجاني حتى %1$@ — بدون اشتراك وبدون طريقة دفع. يبدأ الاشتراك تجربة مجانية مدتها %2$@ من تلك اللحظة، ولا تُضاف إليها أيامك المجانية المتبقية."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ পর্যন্ত ফ্রি — কোনো সাবস্ক্রিপশন নেই, কোনো পেমেন্ট পদ্ধতি নেই। সাবস্ক্রাইব করলে সেই মুহূর্ত থেকে %2$@-এর ফ্রি ট্রায়াল শুরু হয়; আপনার বাকি ফ্রি দিনগুলি তাতে যোগ হয় না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zdarma do %1$@ — bez předplatného, bez platební metody. Předplacením začne od té chvíle bezplatná zkušební verze na %2$@; zbývající dny zdarma se k ní nepřičítají."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kostenlos bis %1$@ – kein Abo, keine Zahlungsmethode. Mit dem Abo beginnt ab diesem Moment eine kostenlose Testphase von %2$@; Ihre verbleibenden freien Tage werden nicht dazugerechnet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Free until %1$@ — no subscription, no payment method. Subscribing starts a %2$@ free trial from that moment; your remaining free days aren't added to it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gratis hasta el %1$@ — sin suscripción ni método de pago. Al suscribirte empieza en ese momento una prueba gratuita de %2$@; tus días gratis restantes no se le suman."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تا %1$@ رایگان — بدون اشتراک و بدون روش پرداخت. با اشتراک، از همان لحظه دورهٔ آزمایشی رایگان %2$@ آغاز می‌شود؛ روزهای رایگان باقی‌مانده به آن افزوده نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Gratuit jusqu'au %1$@ — sans abonnement ni moyen de paiement. L'abonnement lance un essai gratuit de %2$@ à partir de ce moment ; vos jours gratuits restants ne s'y ajoutent pas."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחינם עד %1$@ — ללא מינוי וללא אמצעי תשלום. ההרשמה למינוי מתחילה מאותו רגע תקופת ניסיון בחינם של %2$@; הימים החינמיים שנותרו לא מתווספים אליה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "%1$@ तक मुफ़्त — कोई सब्सक्रिप्शन नहीं, कोई भुगतान विधि नहीं। सब्सक्राइब करने पर उसी क्षण से %2$@ का मुफ़्त ट्रायल शुरू होता है; आपके बचे हुए मुफ़्त दिन उसमें नहीं जुड़ते।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ingyenes eddig: %1$@ – nincs előfizetés, nincs fizetési mód. Az előfizetéssel attól a pillanattól %2$@ ingyenes próbaidőszak indul; a hátralévő ingyenes napok nem adódnak hozzá."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Bezpłatnie do %1$@ — bez subskrypcji, bez metody płatności. Subskrypcja rozpoczyna od tego momentu bezpłatny okres próbny (%2$@); pozostałe bezpłatne dni nie są do niego doliczane."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Бесплатно до %1$@ — без подписки и способа оплаты. С оформлением подписки с этого момента начинается бесплатный пробный период (%2$@); оставшиеся бесплатные дни к нему не добавляются."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Безкоштовно до %1$@ — без передплати та способу оплати. З оформленням передплати з цієї миті починається безкоштовний пробний період (%2$@); решта безкоштовних днів до нього не додається."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "免费使用至 %1$@，无需订阅，也无需付款方式。订阅后将从那一刻起开始 %2$@ 免费试用；剩余的免费天数不会累加进去。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "免費使用至 %1$@ — 不需訂閱，也不需付款方式。訂閱後會從那一刻起開始 %2$@ 免費試用；剩下的免費天數不會累加進去。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "免費使用至 %1$@，無需訂閱，也無需付款方式。訂閱後會由那一刻起開始 %2$@ 免費試用；餘下的免費天數不會累加進去。"
          }
        }
      }
    },
