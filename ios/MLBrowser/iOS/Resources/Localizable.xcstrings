    "slideshow.slide7.description" : {
      "comment" : "Slideshow slide 7 description - Image Properties",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في بعض الحالات، يمكنك مساعدة الكاشف عن طريق تغيير خصائص العرض في المتصفح، مثل السطوع والتباين."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "কিছু ক্ষেত্রে, আপনি ব্রাউজারের রেন্ডারিং বৈশিষ্ট্যগুলি পরিবর্তন করে ডিটেক্টরকে সাহায্য করতে পারেন, যেমন উজ্জ্বলতা এবং কন্ট্রাস্ট।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "V některých případech můžete detektoru pomoci změnou vlastností vykreslování prohlížeče, jako je jas a kontrast."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In einigen Fällen können Sie dem Detektor helfen, indem Sie die Rendering-Eigenschaften des Browsers wie Helligkeit und Kontrast ändern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In some cases, you can aid the detector by altering the browser's rendering properties, such as brightness and contrast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En algunos casos, puede ayudar al detector alterando las propiedades de renderizado del navegador, como el brillo y el contraste."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "در برخی موارد، می‌توانید با تغییر ویژگی‌های رندر مرورگر، مانند روشنایی و کنتراست، به تشخیص‌دهنده کمک کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dans certains cas, vous pouvez aider le détecteur en modifiant les propriétés de rendu du navigateur, comme la luminosité et le contraste."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "במקרים מסוימים, אתה יכול לסייע לגלאי על ידי שינוי מאפייני הרינדור של הדפדפן, כגון בהירות וניגודיות."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "कुछ मामलों में, आप ब्राउज़र के रेंडरिंग गुणों को बदलकर डिटेक्टर की सहायता कर सकते हैं, जैसे चमक और कंट्रास्ट।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bizonyos esetekben segíthet a detektornak a böngésző renderelési tulajdonságainak módosításával, például a fényerő és a kontraszt beállításával."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "W niektórych przypadkach możesz pomóc detektorowi, zmieniając właściwości renderowania przeglądarki, takie jak jasność i kontrast."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "В некоторых случаях вы можете помочь детектору, изменив свойства рендеринга браузера, такие как яркость и контрастность."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "У деяких випадках ви можете допомогти детектору, змінивши властивості рендерингу браузера, такі як яскравість і контрастність."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在某些情况下，您可以通过更改浏览器的渲染属性（如亮度和对比度）来帮助检测器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "在某些情況下，您可以透過變更瀏覽器的渲染屬性（如亮度和對比度）來幫助偵測器。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
