          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اگر چیزی درست به نظر نمی‌رسد، می‌توانید آن عکس صفحه را با توضیحی کوتاه برای ما بفرستید."
