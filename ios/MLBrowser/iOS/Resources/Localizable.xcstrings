    "settings.tiledBordersFooter" : {
      "comment" : "Footer explaining the Tiled Borders toggle",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "يرسم إطارًا أحمر حول كل جزء يُمرَّر إلى أداة الكشف، لترى كيف تُقسَّم الصفحة. لا يتأثر الكشف بذلك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডিটেক্টরে দেওয়া প্রতিটি টাইলের চারপাশে লাল বর্ডার আঁকে, যাতে আপনি দেখতে পান পেজটি কীভাবে ভাগ হয়েছে। শনাক্তকরণে কোনো প্রভাব পড়ে না।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Kolem každé dlaždice předané detektoru vykreslí červený okraj, takže uvidíte, jak je stránka rozdělena. Detekci to neovlivní."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Zeichnet einen roten Rahmen um jede Kachel, die an den Detektor geht, damit Sie die Aufteilung der Seite sehen. Die Erkennung bleibt unverändert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Draws a red border around each tile fed to the detector, so you can see how the page is split. Detection is unaffected."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dibuja un borde rojo alrededor de cada mosaico que se envía al detector, para que veas cómo se divide la página. La detección no se ve afectada."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دور هر کاشی که به تشخیص‌دهنده داده می‌شود کادری قرمز می‌کشد تا ببینید صفحه چگونه تقسیم می‌شود. تشخیص تحت تأثیر قرار نمی‌گیرد."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Trace une bordure rouge autour de chaque tuile transmise au détecteur, pour visualiser le découpage de la page. La détection n’est pas modifiée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "משרטט מסגרת אדומה סביב כל אריח שמוזן לגלאי, כדי שתוכל לראות כיצד העמוד מחולק. אין לכך השפעה על הזיהוי."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "डिटेक्टर को दी गई हर टाइल के चारों ओर लाल बॉर्डर बनाता है, ताकि आप देख सकें कि पेज कैसे बँटा है। पहचान पर कोई असर नहीं पड़ता।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Piros keretet rajzol minden csempe köré, amely a felismerőhöz kerül, így látható, hogyan oszlik fel az oldal. A felismerést ez nem befolyásolja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Rysuje czerwoną ramkę wokół każdego kafelka podawanego do detektora, dzięki czemu widzisz podział strony. Nie wpływa to na detekcję."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Рисует красную рамку вокруг каждого фрагмента, передаваемого детектору, чтобы было видно, как разбита страница. На обнаружение это не влияет."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Малює червону рамку навколо кожного фрагмента, що передається детектору, щоб було видно, як розбито сторінку. На виявлення це не впливає."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在送入检测器的每个分块周围绘制红色边框，让你看清页面的划分方式。检测结果不受影响。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在每個送入偵測器的圖塊周圍繪製紅色邊框，讓你看見頁面如何分割。這不會影響偵測。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "在送入偵測器的每個分塊周圍繪製紅色邊框，讓你看清頁面的劃分方式。偵測結果不受影響。"
          }
        }
      }
    },
