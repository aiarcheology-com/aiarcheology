        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tippen Sie nun auf eine beliebige Stelle der Karte, um Ihren Fund zu markieren."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Now tap anywhere on the map to mark your finding."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ahora toca cualquier punto del mapa para marcar tu hallazgo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حالا هرجای نقشه ضربه بزنید تا یافته‌تان را علامت بزنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Touchez maintenant un point de la carte pour marquer votre découverte."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "עכשיו הקש במקום כלשהו במפה כדי לסמן את הממצא שלך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अब अपनी खोज दर्ज करने के लिए मानचित्र पर कहीं भी टैप करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Most koppintson bárhová a térképen a lelet megjelöléséhez."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Teraz stuknij dowolne miejsce na mapie, aby oznaczyć znalezisko."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Теперь коснитесь любого места на карте, чтобы отметить находку."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Тепер торкніться будь-якого місця на карті, щоб позначити знахідку."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "现在轻点地图上的任意位置，标记你的发现记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在輕點地圖上的任一處，標記你的發現。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "現在輕按地圖上任何位置，標示你的發現記錄。"
          }
        }
      }
    },
