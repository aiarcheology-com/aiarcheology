    "auth.account.deleteBillingNote" : {
      "comment" : "Caption under Settings > Account > Manage Account. Clerk owns the delete confirmation there, so this is the only place we can say that billing continues.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حذف حسابك لا يلغي اشتراكك. يمكنك إلغاؤه من App Store."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাকাউন্ট মুছে ফেললে আপনার সাবস্ক্রিপশন বাতিল হয় না। App Store থেকে বাতিল করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Smazání účtu nezruší vaše předplatné. Zrušte ho v obchodě App Store."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Das Löschen Ihres Accounts kündigt Ihr Abo nicht. Kündigen Sie es im App Store."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deleting your account does not cancel your subscription. Cancel it in the App Store."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Eliminar tu cuenta no cancela tu suscripción. Cancélala en la App Store."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "حذف حساب، اشتراک شما را لغو نمی‌کند. آن را در App Store لغو کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Supprimer votre compte ne résilie pas votre abonnement. Résiliez-le dans l'App Store."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "מחיקת החשבון אינה מבטלת את המנוי שלך. יש לבטל אותו ב-App Store."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "अकाउंट डिलीट करने से आपकी सदस्यता रद्द नहीं होती। उसे App Store में रद्द करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A fiók törlése nem mondja le az előfizetését. Mondja le az App Store-ban."
          }
        },
        "pl" : {
