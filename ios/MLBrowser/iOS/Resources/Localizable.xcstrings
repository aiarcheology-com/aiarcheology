    "welcome.priceNote" : {
      "comment" : "Welcome screen: what a subscription costs once the free window ends. %@ is the localized price with its term.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "بعد انتهاء وصولك المجاني، يمكنك الاشتراك مقابل %@ لمواصلة استخدام ML Browser."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ফ্রি অ্যাক্সেস শেষ হলে, ML Browser ব্যবহার চালিয়ে যেতে আপনি %@ দিয়ে সাবস্ক্রাইব করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po skončení bezplatného přístupu si můžete pořídit předplatné za %@ a dál používat ML Browser."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nach Ende des kostenlosen Zugangs können Sie für %@ abonnieren, um ML Browser weiter zu nutzen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "After your free access ends, you can subscribe for %@ to continue using ML Browser."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cuando termine tu acceso gratuito, podrás suscribirte por %@ para seguir usando ML Browser."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "پس از پایان دسترسی رایگان، می‌توانید با %@ مشترک شوید تا استفاده از ML Browser را ادامه دهید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "À la fin de votre accès gratuit, vous pourrez vous abonner pour %@ afin de continuer à utiliser ML Browser."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לאחר שתסתיים הגישה החינמית, אפשר להירשם למינוי בעלות של %@ כדי להמשיך להשתמש ב-ML Browser."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आपका मुफ़्त एक्सेस खत्म होने के बाद, ML Browser का उपयोग जारी रखने के लिए आप %@ में सब्सक्राइब कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az ingyenes hozzáférés lejárta után %@ összegért fizethet elő, hogy továbbra is használhassa az ML Browsert."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Po zakończeniu bezpłatnego dostępu możesz wykupić subskrypcję za %@, aby dalej korzystać z ML Browser."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "После окончания бесплатного доступа вы сможете оформить подписку за %@ и продолжить пользоваться ML Browser."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Після завершення безкоштовного доступу ви зможете оформити підписку за %@ і продовжити користуватися ML Browser."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "免费使用期结束后，你可以以 %@ 订阅，继续使用 ML Browser。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "免費使用期結束後，你可以用 %@ 訂閱，繼續使用 ML Browser。"
