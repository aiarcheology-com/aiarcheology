    "import.keepOriginalMessage" : {
      "comment" : "Explains that the converted model is used by the app while the original source package is optional provenance storage",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "سيستخدم التطبيق نموذج Core ML المُحوَّل. هل تريد أيضًا الاحتفاظ بنسخة من حزمة النموذج الأصلية للتوثيق أو للتحويل مستقبلًا؟"
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "অ্যাপ রূপান্তরিত Core ML মডেলটি ব্যবহার করবে। উৎসের প্রমাণ বা ভবিষ্যতের রূপান্তরের জন্য আপনি কি মূল মডেল প্যাকেজের একটি কপিও রাখতে চান?"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikace bude používat převedený model Core ML. Chcete si ponechat i kopii původního balíčku modelu kvůli doložení původu nebo budoucímu převodu?"
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die App verwendet das konvertierte Core ML-Modell. Möchten Sie zusätzlich eine Kopie des ursprünglichen Modellpakets für den Herkunftsnachweis oder spätere Konvertierungen behalten?"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The converted Core ML model will be used by the app. Do you also want to keep a copy of the original model package for provenance or future conversion?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La app usará el modelo Core ML convertido. ¿Quieres conservar también una copia del paquete del modelo original, por trazabilidad o para una conversión futura?"
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "برنامه از مدل Core ML تبدیل‌شده استفاده می‌کند. آیا می‌خواهید نسخه‌ای از بستهٔ مدل اصلی را هم برای سابقه یا تبدیل‌های بعدی نگه دارید؟"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L’app utilisera le modèle Core ML converti. Souhaitez-vous aussi conserver une copie du paquet de modèle d’origine, pour la traçabilité ou une conversion ultérieure ?"
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "האפליקציה תשתמש במודל Core ML המומר. האם ברצונך לשמור גם עותק של חבילת המודל המקורית לצורכי תיעוד מקור או המרה עתידית?"
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ऐप कन्वर्ट किए गए Core ML मॉडल का उपयोग करेगा। क्या आप मूल मॉडल पैकेज की एक कॉपी भी रखना चाहते हैं, ताकि उसका स्रोत दर्ज रहे या आगे कन्वर्ज़न किया जा सके?"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az alkalmazás a konvertált Core ML modellt fogja használni. Szeretne megtartani egy másolatot az eredeti modellcsomagról a származás igazolásához vagy későbbi konverzióhoz?"
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aplikacja będzie używać przekonwertowanego modelu Core ML. Czy chcesz zachować także kopię oryginalnego pakietu modelu na potrzeby udokumentowania pochodzenia lub przyszłej konwersji?"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Приложение будет использовать конвертированную модель Core ML. Сохранить также копию исходного пакета модели для истории происхождения или будущей конвертации?"
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Застосунок використовуватиме конвертовану модель Core ML. Зберегти також копію початкового пакета моделі для походження або майбутньої конвертації?"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "App 将使用转换后的 Core ML 模型。是否同时保留一份原始模型包，用于溯源或日后再次转换？"
