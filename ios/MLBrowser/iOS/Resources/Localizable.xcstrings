    "slideshow.slide0.description" : {
      "comment" : "Slideshow slide 0 description - Welcome",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يجمع التطبيق بين تجربة التصفح واكتشاف الأشياء المدعومة داخل محتوى الويب."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "অ্যাপ্লিকেশনটি ওয়েব কন্টেন্টের মধ্যে সহায়ক অবজেক্ট ডিটেকশনের সাথে ব্রাউজিং অভিজ্ঞতা একত্রিত করে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikace kombinuje prohlížení s asistovanou detekcí objektů ve webovém obsahu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anwendung kombiniert das Browser-Erlebnis mit unterstützter Objekterkennung in Webinhalten."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The application combines the browsing experience with assisted object detection within web content."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aplicación combina la experiencia de navegación con la detección asistida de objetos dentro del contenido web."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "این برنامه تجربه مرور را با تشخیص اشیاء کمکی در محتوای وب ترکیب می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'application combine l'expérience de navigation avec la détection d'objets assistée dans le contenu Web."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "היישום משלב את חוויית הגלישה עם זיהוי אובייקטים מסייע בתוכן אינטרנט."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एप्लिकेशन वेब सामग्री के भीतर सहायता प्राप्त ऑब्जेक्ट डिटेक्शन के साथ ब्राउज़िंग अनुभव को जोड़ता है।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az alkalmazás a böngészési élményt egyesíti a webes tartalmak segített objektumfelismerésével."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Aplikacja łączy przeglądanie z asystowanym wykrywaniem obiektów w treści internetowej."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приложение сочетает в себе опыт просмотра с помощью обнаружения объектов в веб-контенте."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Застосунок поєднує досвід перегляду з допоміжним виявленням об'єктів у веб-вмісті."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "该应用将浏览体验与网页内容中的辅助对象检测相结合。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該應用程式將瀏覽體驗與網頁內容中的輔助物件偵測相結合。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "該應用程式將瀏覽體驗與網頁內容中的輔助物件偵測相結合。"
          }
        }
      }
    },
