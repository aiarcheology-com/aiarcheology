    "paywall.pitchFirstMeeting" : {
      "comment" : "Paywall description for a user who has never had app access. The neutral pitch says \"keep using\", which is untrue for someone who has not started.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
