    "settings.tiledDetectionFooter" : {
      "comment" : "Footer for the Tiled Detection submenu explaining the two scheme toggles",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "اختر تخطيطات الأجزاء التي تُمرَّر إلى أداة الكشف. فعّل أحدهما أو كليهما؛ يؤدي تفعيل كليهما إلى تشغيل اتحاد أجزائهما."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "ডিটেক্টরে কোন টাইল লেআউটগুলি যাবে তা বাছুন। যেকোনো একটি বা দুটিই চালু করুন; দুটি চালু থাকলে উভয়ের সব টাইল চলে।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Vyberte, která rozvržení dlaždic se předají detektoru. Zapněte jedno nebo obě; při obou se použije sjednocení jejich dlaždic."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wählen Sie, welche Kachel-Layouts an den Detektor gehen. Aktivieren Sie eines oder beide; bei beiden wird die Vereinigung ihrer Kacheln verwendet."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose which tile layouts feed the detector. Enable either or both; both run the union of their tiles."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Elige qué disposiciones de mosaicos se envían al detector. Activa una o ambas; con las dos, se usa la unión de sus mosaicos."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "انتخاب کنید کدام چیدمان کاشی‌ها به تشخیص‌دهنده داده شود. یکی یا هر دو را فعال کنید؛ فعال بودن هر دو، اجتماع کاشی‌هایشان را اجرا می‌کند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Choisissez les dispositions de tuiles transmises au détecteur. Activez l’une ou les deux ; si les deux sont actives, l’union de leurs tuiles est utilisée."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "בחר אילו פריסות אריחים יוזנו לגלאי. אפשר להפעיל אחת מהן או את שתיהן; יחד מורצים כל האריחים של שתיהן."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "चुनें कि डिटेक्टर को कौन-से टाइल लेआउट दिए जाएँ। कोई एक या दोनों चालू करें; दोनों चालू होने पर उनकी सभी टाइलें चलती हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Válassza ki, mely csempekiosztások kerüljenek a felismerőhöz. Bármelyik vagy mindkettő bekapcsolható; mindkettő esetén a csempéik uniója fut."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Wybierz, które układy kafelków trafiają do detektora. Włącz jeden lub oba; przy obu używana jest suma ich kafelków."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Выберите, какие схемы разбиения передавать детектору. Включите одну или обе; при обеих используется объединение их фрагментов."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Виберіть, які схеми розбиття передавати детектору. Увімкніть одну або обидві; за обох використовується об’єднання їхніх фрагментів."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "选择送入检测器的分块布局。可启用其中一种或两种；同时启用时会运行两者分块的并集。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選擇要送入偵測器的圖塊配置。可啟用其中一種或兩種；兩種都啟用時會執行其圖塊的聯集。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "選擇送入偵測器的分塊版面。可啟用其中一種或兩種；同時啟用時會運行兩者分塊的聯集。"
          }
        }
      }
    },
