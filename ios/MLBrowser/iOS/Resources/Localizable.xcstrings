    "browser.load.error.message" : {
      "comment" : "Body of the overlay shown when a web page could not be loaded.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر الوصول إلى الصفحة. تحقق من اتصالك وحاول مرة أخرى."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "পেজটিতে পৌঁছানো যায়নি। আপনার কানেকশন দেখে আবার চেষ্টা করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Stránku se nepodařilo načíst. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Die Seite konnte nicht erreicht werden. Prüfen Sie Ihre Verbindung und versuchen Sie es erneut."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The page couldn’t be reached. Check your connection and try again."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo acceder a la página. Comprueba tu conexión e inténtalo de nuevo."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "دسترسی به صفحه ممکن نشد. اتصال خود را بررسی و دوباره تلاش کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "La page est inaccessible. Vérifiez votre connexion et réessayez."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן היה להגיע לעמוד. בדוק את החיבור ונסה שוב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "पेज तक पहुँचा नहीं जा सका। अपना कनेक्शन जाँचें और फिर कोशिश करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Az oldal nem érhető el. Ellenőrizze a kapcsolatot, és próbálja újra."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się otworzyć strony. Sprawdź połączenie i spróbuj ponownie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось открыть страницу. Проверьте подключение и попробуйте снова."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося відкрити сторінку. Перевірте з’єднання та спробуйте ще раз."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "无法访问该网页。请检查网络连接后重试。"
