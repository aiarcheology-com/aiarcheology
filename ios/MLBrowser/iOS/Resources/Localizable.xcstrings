    "welcome.body" : {
      "comment" : "Welcome screen (AIA-0567): why there is nothing to decide on day 0.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "لا حاجة إلى اشتراك اليوم. خذ وقتك، واكتشف التطبيق، وقرر لاحقًا إن كان مناسبًا لك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আজ কোনো সাবস্ক্রিপশন লাগবে না। সময় নিয়ে অ্যাপটি ঘুরে দেখুন, আর পরে ঠিক করুন এটি আপনার জন্য উপযুক্ত কিনা।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dnes není potřeba žádné předplatné. Nespěchejte, objevujte aplikaci a později se rozhodněte, jestli je pro vás ta pravá."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Heute ist kein Abonnement nötig. Nehmen Sie sich Zeit, entdecken Sie die App und entscheiden Sie später, ob sie zu Ihnen passt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No subscription required today. Take your time, discover the app, and decide later if it's right for you."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Hoy no necesitas ninguna suscripción. Tómate tu tiempo, descubre la app y decide más adelante si es para ti."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "امروز به اشتراک نیازی نیست. با آرامش برنامه را کشف کنید و بعداً تصمیم بگیرید که مناسب شماست یا نه."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Aucun abonnement requis aujourd’hui. Prenez votre temps, découvrez l’app et décidez plus tard si elle vous convient."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא נדרש מינוי היום. קח את הזמן, גלה את האפליקציה, והחלט בהמשך אם היא מתאימה לך."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "आज किसी सब्सक्रिप्शन की ज़रूरत नहीं। आराम से ऐप देखें, और बाद में तय करें कि यह आपके लिए सही है या नहीं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ma nincs szükség előfizetésre. Szánjon rá időt, fedezze fel az alkalmazást, és később döntse el, megfelelő-e Önnek."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dziś subskrypcja nie jest potrzebna. Nie spiesz się, poznaj aplikację i zdecyduj później, czy jest dla ciebie."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сегодня подписка не нужна. Не спешите, познакомьтесь с приложением и решите позже, подходит ли оно вам."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Сьогодні підписка не потрібна. Не поспішайте, ознайомтеся із застосунком і вирішіть пізніше, чи він вам підходить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "今天无需订阅。慢慢体验这款 App，之后再决定它是否适合你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
