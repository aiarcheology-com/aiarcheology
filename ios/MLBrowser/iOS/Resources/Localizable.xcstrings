    "import.supportedModelsInfo" : {
      "comment" : "Information about supported model types",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر نموذج Create ML (.mlmodel أو .mlpackage) يدعم اكتشاف الأشياء. أنواع النماذج الأخرى غير مدعومة في هذا الإصدار."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "এমন একটি Create ML মডেল (.mlmodel বা .mlpackage) চয়ন করুন যা অবজেক্ট ডিটেকশন সমর্থন করে। এই সংস্করণে অন্যান্য মডেল প্রকার সমর্থিত নয়।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vyberte model Create ML (.mlmodel nebo .mlpackage), který podporuje detekci objektů. Ostatní typy modelů nejsou v této verzi podporovány."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wählen Sie ein Create ML-Modell (.mlmodel oder .mlpackage), das Objekterkennung unterstützt. Andere Modelltypen werden in dieser Version nicht unterstützt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choose a Core ML model (.mlmodel or .mlpackage) that supports object detection or image classification. Other model types are not supported in this version."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elija un modelo Create ML (.mlmodel o .mlpackage) que admita la detección de objetos. Otros tipos de modelos no son compatibles con esta versión."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "یک مدل Create ML (.mlmodel یا .mlpackage) که از تشخیص اشیاء پشتیبانی می‌کند انتخاب کنید. سایر انواع مدل در این نسخه پشتیبانی نمی‌شوند."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Choisissez un modèle Create ML (.mlmodel ou .mlpackage) qui prend en charge la détection d'objets. Les autres types de modèles ne sont pas pris en charge dans cette version."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "בחר מודל Create ML (.mlmodel או .mlpackage) התומך בזיהוי אובייקטים. סוגי מודלים אחרים אינם נתמכים בגרסה זו."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "एक Create ML मॉडल (.mlmodel या .mlpackage) चुनें जो ऑब्जेक्ट डिटेक्शन का समर्थन करता है। अन्य मॉडल प्रकार इस संस्करण में समर्थित नहीं हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válasszon olyan Create ML modellt (.mlmodel vagy .mlpackage), amely támogatja az objektumfelismerést. Más modelltípusok nem támogatottak ebben a verzióban."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wybierz model Create ML (.mlmodel lub .mlpackage), który obsługuje wykrywanie obiektów. Inne typy modeli nie są obsługiwane w tej wersji."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Выберите модель Create ML (.mlmodel или .mlpackage), которая поддерживает обнаружение объектов. Другие типы моделей не поддерживаются в этой версии."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Виберіть модель Create ML (.mlmodel або .mlpackage), яка підтримує виявлення об'єктів. Інші типи моделей не підтримуються в цій версії."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "选择支持对象检测的 Create ML 模型（.mlmodel 或 .mlpackage）。此版本不支持其他模型类型。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "選擇支援物件偵測的 Create ML 模型（.mlmodel 或 .mlpackage）。此版本不支援其他模型類型。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
