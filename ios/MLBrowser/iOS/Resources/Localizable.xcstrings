        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "আপনার ফ্রি অ্যাক্সেস শেষ হয়ে গেছে। ML Browser ব্যবহার চালিয়ে যেতে এবং ভবিষ্যতের সব আপডেট ও উন্নতি পেতে সাবস্ক্রাইব করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Váš bezplatný přístup skončil. Objednejte si předplatné, abyste mohli ML Browser dál používat a dostávat všechny budoucí aktualizace a vylepšení."
