    "paywall.failed.message" : {
      "comment" : "Shown when a purchase attempt fails or cannot be verified. Deliberately does not assert whether the account was charged — an unverified transaction may already have settled.",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تعذّر إتمام عملية الشراء. يُرجى المحاولة مرة أخرى، أو استخدم «استعادة المشتريات» إذا سبق أن تم خصم المبلغ من حساب Apple الخاص بك."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "কেনাকাটা সম্পূর্ণ করা যায়নি। অনুগ্রহ করে আবার চেষ্টা করুন, অথবা আপনার Apple অ্যাকাউন্ট থেকে ইতিমধ্যেই টাকা কেটে নেওয়া হয়ে থাকলে “কেনাকাটা পুনরুদ্ধার করুন” ব্যবহার করুন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nákup se nepodařilo dokončit. Zkuste to prosím znovu, nebo použijte Obnovit nákupy, pokud už byla z vašeho účtu Apple stržena platba."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Der Kauf konnte nicht abgeschlossen werden. Bitte versuchen Sie es erneut oder verwenden Sie „Käufe wiederherstellen“, falls Ihr Apple-Account bereits belastet wurde."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The purchase could not be completed. Please try again, or use Restore Purchases if your Apple Account was already charged."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "No se pudo completar la compra. Inténtalo de nuevo o usa Restaurar compras si ya se ha realizado el cargo en tu cuenta de Apple."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "خرید کامل نشد. لطفاً دوباره تلاش کنید، یا اگر مبلغ از حساب Apple شما کسر شده است از «بازیابی خریدها» استفاده کنید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "L'achat n'a pas pu être finalisé. Veuillez réessayer ou utiliser Restaurer les achats si votre compte Apple a déjà été débité."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "לא ניתן היה להשלים את הרכישה. יש לנסות שוב, או להשתמש באפשרות שחזור רכישות אם חשבון Apple שלך כבר חויב."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "खरीदारी पूरी नहीं हो सकी। कृपया फिर से कोशिश करें, या अगर आपके Apple खाते से पहले ही शुल्क लिया जा चुका है तो “खरीदारी पुनर्स्थापित करें” का उपयोग करें।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A vásárlást nem sikerült befejezni. Próbálja újra, vagy használja a Vásárlások visszaállítása lehetőséget, ha az Apple-fiókját már megterhelték."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Nie udało się sfinalizować zakupu. Spróbuj ponownie lub użyj opcji Przywróć zakupy, jeśli z Twojego konta Apple pobrano już opłatę."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не удалось завершить покупку. Повторите попытку или используйте «Восстановить покупки», если средства с вашей учётной записи Apple уже были списаны."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Не вдалося завершити покупку. Спробуйте ще раз або скористайтеся функцією «Відновити покупки», якщо кошти з вашого облікового запису Apple уже було списано."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "购买未能完成。请重试；如果你的 Apple 账户已被扣款，请使用“恢复购买项目”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "無法完成購買。請再試一次；如果你的 Apple 帳號已被收取款項，請使用「回復購買項目」。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "購買未能完成。請再試一次；如果你的 Apple 帳戶已被扣款，請使用「回復購買項目」。"
          }
        }
      }
    },
