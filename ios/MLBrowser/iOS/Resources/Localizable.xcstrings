    "paywall.pending.message" : {
      "comment" : "Shown when a purchase awaits approval (Ask to Buy).",
      "extractionState" : "manual",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "تحتاج عملية الشراء هذه إلى موافقة قبل أن تكتمل. وسيتم منح الوصول تلقائيًا بمجرد الموافقة عليها — يمكنك إغلاق هذه الشاشة."
          }
        },
        "bn" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "এই কেনাকাটা সম্পূর্ণ হওয়ার আগে অনুমোদন প্রয়োজন। অনুমোদন পাওয়ার সঙ্গে সঙ্গেই স্বয়ংক্রিয়ভাবে অ্যাক্সেস দেওয়া হয় — আপনি এই স্ক্রিন বন্ধ করতে পারেন।"
          }
        },
        "cs" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Tento nákup musí být před dokončením schválen. Po schválení se přístup udělí automaticky – tuto obrazovku můžete zavřít."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Dieser Kauf muss erst genehmigt werden. Nach der Genehmigung wird der Zugriff automatisch freigeschaltet – Sie können diese Ansicht schließen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This purchase needs approval before it can complete. Access is granted automatically once it is approved — you can close this screen."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Esta compra necesita aprobación para poder completarse. El acceso se concede automáticamente en cuanto se apruebe — puedes cerrar esta pantalla."
          }
        },
        "fa" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "این خرید برای تکمیل شدن به تأیید نیاز دارد. پس از تأیید، دسترسی به‌طور خودکار داده می‌شود — می‌توانید این صفحه را ببندید."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Cet achat doit être approuvé avant d'être finalisé. L'accès est accordé automatiquement dès l'approbation — vous pouvez fermer cet écran."
          }
        },
        "he" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "הרכישה הזו מחייבת אישור לפני שאפשר יהיה להשלים אותה. הגישה תינתן אוטומטית לאחר האישור — אפשר לסגור את המסך הזה."
          }
        },
        "hi" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "इस खरीदारी के पूरा होने से पहले मंज़ूरी ज़रूरी है। मंज़ूरी मिलते ही एक्सेस अपने आप मिल जाता है — आप यह स्क्रीन बंद कर सकते हैं।"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "A vásárlást jóvá kell hagyni a befejezéshez. A jóváhagyás után a hozzáférés automatikusan megnyílik – ezt a képernyőt bezárhatja."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Ten zakup wymaga zatwierdzenia, zanim będzie mógł zostać sfinalizowany. Po zatwierdzeniu dostęp zostanie przyznany automatycznie – możesz zamknąć ten ekran."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Эта покупка должна быть одобрена, прежде чем она завершится. После одобрения доступ будет предоставлен автоматически — этот экран можно закрыть."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "Цю покупку потрібно схвалити, перш ніж вона завершиться. Після схвалення доступ буде надано автоматично — цей екран можна закрити."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此次购买需经批准才能完成。获批准后会自动开通使用权限，你可以关闭此界面。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此購買項目需經核准才能完成。核准後即會自動取得使用權限，你可以關閉此畫面。"
          }
        },
        "zh-HK" : {
          "stringUnit" : {
            "state" : "needs_review",
            "value" : "此購買須經批准才能完成。獲批准後會自動開通使用權限，你可以關閉此畫面。"
          }
        }
      }
    },
