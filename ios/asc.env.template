# ios/asc.env.template — App Store Connect delivery credentials for scripts/deliver.sh.
#
# Copy to ios/asc.env (gitignored) and point these at your 1Password item, then unlock `op`:
#   cp ios/asc.env.template ios/asc.env      # edit the vault/item/key-id to match yours
#
# These are 1Password REFERENCES, not secrets — deliver.sh resolves them with `op read` at run time
# (the .p8 is streamed into a 0600 temp that is wiped on exit; it never lands on disk). Unlike the
# build secrets in Secrets.template.xcconfig, the ASC key is a DELIVERY credential and must NOT be
# compiled into the app.
#
# The 1Password item should be an App Store Connect API key with the **App Manager** role (needed to
# upload builds and write TestFlight "What to Test"). Store the Key ID and Issuer ID as fields and
# attach the AuthKey_<KEYID>.p8 file.
#
# Explicit ASC_* environment variables always take precedence over this file.

export ASC_KEY_ID='op://Personal/App Store Connect API Key/key id'
export ASC_ISSUER_ID='op://Personal/App Store Connect API Key/issuer id'
export ASC_KEY_OP_REF='op://Personal/App Store Connect API Key/AuthKey_<KEYID>.p8'
